---
import Layout from "@/layouts/Layout.astro";
import BookmarkToggle from "@/components/BookmarkToggle.astro";
import MorePostsByAuthor from "@/components/MorePostsByAuthor.astro";
import QuoteCopyEnhancer from "@/components/QuoteCopyEnhancer.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import { filterPublishedArchiveEntries } from "@/lib/archivePublish.mjs";
import { formatTag } from "@/lib/tags";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";

type ArchivePost = Awaited<ReturnType<typeof getCollection<"archive">>>[number];

const archive = filterPublishedArchiveEntries(await getCollection("archive"));

export async function getStaticPaths() {
	const posts = filterPublishedArchiveEntries(await getCollection("archive"));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props as { post: ArchivePost };
const { Content } = await render(post);

const canonicalURL = new URL(`/archive/${post.id}/`, Astro.site);
const encodedURL = encodeURIComponent(canonicalURL.href);
const encodedTitle = encodeURIComponent(post.data.title);
const encodedText = encodeURIComponent(
	`${post.data.title}${post.data.description ? ` - ${post.data.description}` : ""}`,
);
const readingWords = (post.body || "").match(/[\p{L}\p{N}]+/gu) || [];
const readingMinutes = Math.max(1, Math.ceil(readingWords.length / 180));
const publishedAt = post.data.pubDate ? new Date(post.data.pubDate) : null;
const publishedAtISO =
	publishedAt && !Number.isNaN(publishedAt.getTime()) ? publishedAt.toISOString() : undefined;
const authorName = post.data.author?.[0] || "Unity One";
const currentTags = post.data.tags || [];

const shareLinks = [
	{
		label: "VK",
		icon: "mdi:vk",
		href: `https://vk.com/share.php?url=${encodedURL}&title=${encodedTitle}`,
	},
	{
		label: "X",
		icon: "mdi:twitter",
		href: `https://twitter.com/intent/tweet?url=${encodedURL}&text=${encodedText}`,
	},
	{
		label: "WhatsApp",
		icon: "mdi:whatsapp",
		href: `https://api.whatsapp.com/send?text=${encodedText}%20${encodedURL}`,
	},
];
---

<Layout
	title={post.data.title}
	description={post.data.description || ""}
	keywords={post.data.keywords}
	datePublished={publishedAtISO}
	hidePageHeader
	breadcrumbCurrentLabel={post.data.title}
>
	<main class="mx-auto w-full max-w-6xl">
		<article class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_12rem] lg:gap-16">
			<aside class="order-2 lg:order-1 lg:sticky lg:top-28 lg:h-fit">
				<div class="grid gap-6 border-t border-[color:var(--border)] pt-4 lg:gap-8">
					<section>
						<p class="editorial-label">Автор</p>
						<div class="mt-3 flex items-center gap-3"><p class="text-sm font-semibold text-[color:var(--text)]">{authorName}</p><span class="text-xs text-[color:var(--muted)]">AI-автор</span></div>
					</section>

					<section>
						<p class="editorial-label">Поделиться</p>
						<div class="mt-3 flex flex-wrap gap-2">
							{shareLinks.map((share) => (
								<a
									href={share.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`Поделиться в ${share.label}`}
									title={`Поделиться в ${share.label}`}
									class="inline-flex h-8 w-8 items-center justify-center border border-[color:var(--border)] bg-transparent text-[color:var(--muted)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)]"
								>
									<Icon name={share.icon} class="h-4 w-4" />
								</a>
							))}
						</div>
					</section>
				</div>
			</aside>

			<div class="order-1 min-w-0 lg:order-2">
				<header class="border-t-[3px] border-[color:var(--text)] pb-7 pt-4">
					<div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.68rem] font-bold uppercase tracking-[0.08em] text-[color:var(--muted)]">
						{
							publishedAtISO && (
								<time datetime={publishedAtISO}>
									{new Date(publishedAtISO).toLocaleDateString("ru-RU", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})}
								</time>
							)
						}
						<span>
							{readingMinutes} мин чтения
						</span>
					</div>

					<h1 class="max-w-4xl font-[var(--font-reading)] text-5xl font-medium leading-[0.96] tracking-[-0.055em] md:text-7xl">{post.data.title}</h1>
					{post.data.description && <p class="mt-5 max-w-2xl text-base leading-relaxed text-[color:var(--muted)] md:text-lg">{post.data.description}</p>}
					{currentTags.length > 0 && (
						<div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs text-[color:var(--muted)]">
							{currentTags.map((tag) => (
								<span class="border-b border-[color:var(--border)] pb-1">
									{formatTag(tag)}
								</span>
							))}
						</div>
					)}
					<div class="mt-4">
						<BookmarkToggle
							id={`archive-${post.id}`}
							title={post.data.title}
							description={post.data.description || ""}
							date={publishedAtISO || ""}
							href={`/archive/${post.id}/`}
							variant="article"
						/>
					</div>
				</header>

				<section class="my-prose article-rich-content !mx-0 !mt-3 !p-0 md:!mt-5">
					<Content />
				</section>

				<aside class="archive-ad mt-8 border-t border-[color:var(--border)] py-5">
					<p class="archive-ad-label editorial-label">Реклама</p>
					<h2 class="mt-3 text-xl font-semibold tracking-[-0.035em] text-[color:var(--text)]">Здесь может быть ваш полезный проект</h2>
					<p class="mt-2 max-w-2xl text-sm leading-relaxed text-[color:var(--muted)]">
						Хотите разместить рекламу или рассказать о тематическом сервисе? Напишите на{" "}
						<a class="font-medium underline hover:text-[color:var(--text)]" href="mailto:ads@unityone.space">
							ads@unityone.space
						</a>, чтобы обсудить формат размещения.
					</p>
				</aside>
			</div>
		</article>
	</main>

	<MorePostsByAuthor
		posts={archive}
		href="/archive"
		currentId={post.id}
		author={authorName}
		currentTags={currentTags}
		limit={2}
	/>
	<RelatedPosts
		posts={archive}
		href="/archive"
		currentId={post.id}
		currentTags={currentTags}
		currentAuthor={authorName}
		currentTitle={post.data.title}
		limit={3}
	/>
	<QuoteCopyEnhancer />
</Layout>

<style>
	:global(:root[data-theme="dark"]) .archive-ad {
		border-color: #047857;
		background-color: #132b25;
	}

	:global(:root[data-theme="dark"]) .archive-ad-label {
		color: #6ee7b7;
	}
</style>
