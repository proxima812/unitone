---
import Layout from "@/layouts/Layout.astro";
import BookmarkToggle from "@/components/BookmarkToggle.astro";
import MorePostsByAuthor from "@/components/MorePostsByAuthor.astro";
import QuoteCopyEnhancer from "@/components/QuoteCopyEnhancer.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import { filterPublishedArchiveEntries } from "@/lib/archivePublish.mjs";
import { getArchiveSlug } from "@/lib/archiveSlug";
import { formatTag } from "@/lib/tags";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";

type ArchivePost = Awaited<ReturnType<typeof getCollection<"archive">>>[number];

const archive = filterPublishedArchiveEntries(await getCollection("archive"));

export async function getStaticPaths() {
	const posts = filterPublishedArchiveEntries(await getCollection("archive")) as ArchivePost[];
	return posts.map((post) => ({
		params: { slug: getArchiveSlug(post.id) },
		props: { post },
	}));
}

const { post } = Astro.props as { post: ArchivePost };
const postSlug = getArchiveSlug(post.id);
const { Content } = await render(post);

const canonicalURL = new URL(`/archive/${postSlug}/`, Astro.site);
const encodedURL = encodeURIComponent(canonicalURL.href);
const encodedTitle = encodeURIComponent(post.data.title);
const encodedText = encodeURIComponent(
	`${post.data.title}${post.data.description ? ` - ${post.data.description}` : ""}`,
);
const readingWords = (post.body || "").match(/[\p{L}\p{N}]+/gu) || [];
const readingMinutes = Math.max(1, Math.ceil(readingWords.length / 180));
const publishedAt = post.data.pubDate ? new Date(post.data.pubDate) : null;
const publishedAtISO =
	publishedAt && !Number.isNaN(publishedAt.getTime()) ? publishedAt.toISOString() : undefined;
const authorName = post.data.author?.[0] || "Unity One";
const currentTags = post.data.tags || [];

const shareLinks = [
	{
		label: "VK",
		icon: "mdi:vk",
		href: `https://vk.com/share.php?url=${encodedURL}&title=${encodedTitle}`,
	},
	{
		label: "X",
		icon: "mdi:twitter",
		href: `https://twitter.com/intent/tweet?url=${encodedURL}&text=${encodedText}`,
	},
	{
		label: "WhatsApp",
		icon: "mdi:whatsapp",
		href: `https://api.whatsapp.com/send?text=${encodedText}%20${encodedURL}`,
	},
	{
		label: "Telegram",
		icon: "mdi:send",
		href: `https://t.me/share/url?url=${encodedURL}&text=${encodedText}`,
	},
];
---

<Layout
	title={post.data.title}
	description={post.data.description || ""}
	keywords={post.data.keywords}
	datePublished={publishedAtISO}
	author={authorName}
	ogImage={post.data.ogImage}
	type="article"
	hidePageHeader
	breadcrumbCurrentLabel={post.data.title}
>
	<main class="mx-auto w-full max-w-6xl">
		<article class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-16">
			<!-- Sidebar -->
			<aside class="order-2 lg:order-1 lg:sticky lg:top-28 lg:h-fit">
				<div class="card space-y-6">
					<!-- Author -->
					<section>
						<p class="editorial-label">Автор</p>
						<div class="mt-3 flex items-center gap-3">
							<div class="flex h-10 w-10 items-center justify-center rounded-full bg-[color:var(--accent-soft)]">
								<Icon name="mdi:account" class="h-5 w-5 text-[color:var(--accent)]" />
							</div>
							<div>
								<p class="text-sm font-semibold text-[color:var(--text)]">{authorName}</p>
								<span class="text-xs text-[color:var(--muted)]">AI-автор</span>
							</div>
						</div>
					</section>

					<div class="h-px bg-[color:var(--border)]"></div>

					<!-- Reading Info -->
					<section class="flex items-center gap-4 text-sm">
						<div class="flex items-center gap-2 text-[color:var(--muted)]">
							<Icon name="mdi:clock-outline" class="h-4 w-4" />
							<span>{readingMinutes} мин</span>
						</div>
						{publishedAtISO && (
							<time datetime={publishedAtISO} class="text-[color:var(--muted)]">
								{new Date(publishedAtISO).toLocaleDateString("ru-RU", {
									day: "numeric",
									month: "short",
								})}
							</time>
						)}
					</section>

					<div class="h-px bg-[color:var(--border)]"></div>

					<!-- Share -->
					<section>
						<p class="editorial-label">Поделиться</p>
						<div class="mt-3 flex flex-wrap gap-2">
							{shareLinks.map((share) => (
								<a
									href={share.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`Поделиться в ${share.label}`}
									title={`Поделиться в ${share.label}`}
									class="icon-btn"
								>
									<Icon name={share.icon} class="h-4 w-4" />
								</a>
							))}
						</div>
					</section>

					<div class="h-px bg-[color:var(--border)]"></div>

					<!-- Bookmark -->
					<section>
						<BookmarkToggle
							id={`archive-${post.id}`}
							title={post.data.title}
							description={post.data.description || ""}
							date={publishedAtISO || ""}
							href={`/archive/${postSlug}/`}
							variant="article"
						/>
					</section>
				</div>
			</aside>

			<!-- Main Content -->
			<div class="order-1 min-w-0 lg:order-2">
				<!-- Back Link -->
				<a href="/archive/" class="btn btn-ghost mb-6 inline-flex gap-2 !px-0 text-sm">
					<Icon name="mdi:arrow-left" class="h-4 w-4" />
					<span>Все статьи</span>
				</a>

				<!-- Header -->
				<header class="mb-10">
					<!-- Tags -->
					{currentTags.length > 0 && (
						<div class="mb-5 flex flex-wrap gap-2">
							{currentTags.map((tag) => (
								<span class="badge text-xs">{formatTag(tag)}</span>
							))}
						</div>
					)}

					<h1 class="max-w-4xl text-3xl font-bold leading-tight tracking-tight md:text-5xl lg:text-6xl">
						{post.data.title}
					</h1>

					{post.data.description && (
						<p class="mt-5 max-w-3xl text-lg leading-relaxed text-[color:var(--text-secondary)] md:text-xl">
							{post.data.description}
						</p>
					)}
				</header>

				<!-- Article Content -->
				<section class="my-prose article-rich-content !mx-0 !mt-0 !p-0">
					<Content />
				</section>

				<!-- Ad Section -->
				<aside class="archive-ad mt-12 rounded-xl border border-emerald-200 bg-emerald-50 p-6 dark:border-emerald-800 dark:bg-emerald-950/30">
					<div class="flex items-start gap-4">
						<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-900/50">
							<Icon name="mdi:bullhorn-outline" class="h-5 w-5 text-emerald-600 dark:text-emerald-400" />
						</div>
						<div>
							<p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Реклама</p>
							<h2 class="mt-1 text-lg font-semibold text-emerald-900 dark:text-emerald-100">Здесь может быть ваш полезный проект</h2>
							<p class="mt-2 text-sm leading-relaxed text-emerald-700 dark:text-emerald-300">
								Хотите разместить рекламу или рассказать о тематическом сервисе? Напишите на{" "}
								<a class="font-medium underline hover:text-emerald-900 dark:hover:text-white" href="mailto:ads@unityone.space">
									ads@unityone.space
								</a>, чтобы обсудить формат размещения.
							</p>
						</div>
					</div>
				</aside>
			</div>
		</article>
	</main>

	<MorePostsByAuthor
		posts={archive}
		href="/archive"
		currentId={post.id}
		author={authorName}
		currentTags={currentTags}
		limit={2}
	/>
	<RelatedPosts
		posts={archive}
		href="/archive"
		currentId={post.id}
		currentTags={currentTags}
		currentAuthor={authorName}
		currentTitle={post.data.title}
		limit={3}
	/>
	<QuoteCopyEnhancer />
</Layout>
