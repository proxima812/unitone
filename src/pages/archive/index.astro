---
import Article from "@/components/Article.astro";
import ArchiveFilter from "@/components/ArchiveFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { filterPublishedArchiveEntries } from "@/lib/archivePublish.mjs";
import { getArchiveSlug } from "@/lib/archiveSlug";
import { formatTag } from "@/lib/tags";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

type ArchivePost = Awaited<ReturnType<typeof getCollection<"archive">>>[number];

export const prerender = true;

const posts = (filterPublishedArchiveEntries(await getCollection("archive")) as ArchivePost[]).sort((a, b) => {
	const aTime = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
	const bTime = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
	return bTime - aTime;
});

const featuredPost = posts[0] || null;
const restPosts = posts.slice(1);
const tags = Array.from(new Set(posts.flatMap((item) => item.data.tags || []))).sort((a, b) => a.localeCompare(b));
---

<Layout title="Статьи и посты" description="Исследования, руководства и заметки о 12 шагах, сообществах и практике." hidePageHeader>
	<main class="mx-auto w-full max-w-6xl">
		<!-- Hero Header -->
		<header class="grid gap-10 pb-12 pt-6 lg:grid-cols-[1.3fr_0.7fr] lg:gap-16 lg:pb-16">
			<div>
				<span class="badge mb-5">Библиотека Unity One</span>
				<h1 class="text-[clamp(2.5rem,7vw,5rem)] font-black leading-[0.92] tracking-[-0.04em]">
					Статьи<br />и посты
				</h1>
				<p class="mt-5 max-w-xl text-base leading-relaxed text-[color:var(--text-secondary)] md:text-lg">
					Материалы о программе 12 шагов: понятные объяснения, практические руководства, история и исследования.
				</p>
			</div>
			<div class="flex flex-col justify-end">
				<div class="grid grid-cols-2 gap-4">
					<div class="card text-center">
						<strong class="block text-3xl font-black tracking-tight text-[color:var(--accent)]">{posts.length}</strong>
						<span class="mt-1 text-sm text-[color:var(--muted)]">материалов</span>
					</div>
					<div class="card text-center">
						<strong class="block text-3xl font-black tracking-tight text-[color:var(--accent)]">{tags.length}</strong>
						<span class="mt-1 text-sm text-[color:var(--muted)]">тем</span>
					</div>
				</div>
			</div>
		</header>

		<!-- Featured Post -->
		{featuredPost && (
			<section class="border-y border-[color:var(--border)] py-10 md:py-14">
				<div class="grid gap-8 lg:grid-cols-[1.4fr_0.6fr] lg:gap-12">
					<div>
						<span class="editorial-label">Рекомендуемая статья</span>
						<a href={`/archive/${getArchiveSlug(featuredPost.id)}/`} class="group mt-4 block">
							<h2 class="max-w-4xl text-3xl font-bold leading-tight tracking-tight transition-colors group-hover:text-[color:var(--accent)] md:text-5xl">
								{featuredPost.data.title}
							</h2>
							{featuredPost.data.description && (
								<p class="mt-4 max-w-2xl text-base leading-relaxed text-[color:var(--text-secondary)] md:text-lg">
									{featuredPost.data.description}
								</p>
							)}
							<span class="btn btn-primary mt-6 inline-flex">
								<span>Читать статью</span>
								<Icon name="mdi:arrow-right" class="h-4 w-4" />
							</span>
						</a>
					</div>
					<div class="card self-end">
						<p class="text-sm font-semibold text-[color:var(--text)]">Темы библиотеки</p>
						<div class="mt-4 flex flex-wrap gap-2">
							{tags.slice(0, 8).map((tag) => (
								<span class="badge badge-muted text-xs">{formatTag(tag)}</span>
							))}
						</div>
						<p class="mt-5 text-sm leading-relaxed text-[color:var(--muted)]">
							Открывайте материалы напрямую из каталога и переходите к первичным источникам.
						</p>
					</div>
				</div>
			</section>
		)}

		<!-- Posts Catalog -->
		<section class="py-10 md:py-14">
			<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
				<div>
					<span class="editorial-label">Каталог</span>
					<h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">Все материалы</h2>
				</div>
				<span class="badge badge-muted">Сначала новые</span>
			</div>
			<ArchiveFilter tags={tags} />
			<div data-posts class="mt-8 divide-y divide-[color:var(--border)]">
				{restPosts.map((article) => <Article data={article.data} id={article.id} hrefBase="/archive" />)}
			</div>
		</section>
	</main>
</Layout>
