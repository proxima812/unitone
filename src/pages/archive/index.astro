---
import Article from "@/components/Article.astro";
import UserArchiveCard from "@/components/UserArchiveCard.astro";
import Layout from "@/layouts/Layout.astro";
import { listPublishedArticles } from "@/lib/db/articles";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store, max-age=0, must-revalidate");

const archives = await listPublishedArticles();

const staticArticles = await getCollection("archive");
const featuredStaticPostId = "admin-panel-open-posts";
const featuredStaticPost = staticArticles.find((item) => item.id === featuredStaticPostId);
const staticArticlesRest = staticArticles.filter((item) => item.id !== featuredStaticPostId);
const staticArticlesTags = Array.from(
	new Set(staticArticles.flatMap((item) => item.data.tags || []).filter(Boolean)),
).sort((a, b) => a.localeCompare(b));
---

<Layout
	title="Статьи 12 шагов"
	description="Статьи о 12 шагах: шаги выздоровления, практики, темы и опыт."
>
	<!-- <ArchiveFilter tags={staticArticlesTags} /> -->

	{
		featuredStaticPost && (
			<section class="mb-4 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5">
				<div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
					<div class="min-w-0">
						<p class="inline-flex rounded-full border border-[color:var(--border)] px-3 py-1 text-xs font-semibold uppercase tracking-wide text-[color:var(--muted)]">
							Закреплено • Для авторов
						</p>
						<h2 class="mt-3 text-xl font-bold text-[color:var(--text)] md:text-2xl">
							{featuredStaticPost.data.title}
						</h2>
						<p class="mt-2 text-sm text-[color:var(--muted)]">
							{featuredStaticPost.data.description}
						</p>
					</div>
					<div class="flex shrink-0 flex-wrap gap-2">
						<a
							href={`/archive/static/${featuredStaticPost.id}/`}
							class="rounded-lg border border-[color:var(--border)] px-4 py-2 text-sm font-semibold text-[color:var(--text)] hover:border-[color:var(--primary)] hover:text-[color:var(--primary)]"
						>
							Читать гайд
						</a>
						<a
							href="/admin"
							class="rounded-lg bg-[color:var(--primary)] px-4 py-2 text-sm font-semibold text-white hover:bg-[var(--sk-button-background-hover)] active:bg-[var(--sk-button-background-active)]"
						>
							Написать материал
						</a>
					</div>
				</div>
			</section>
		)
	}

	<section class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3" data-posts>
		<div class="p-2 rounded-2xl">
			<article
				class="grid place-items-center border border-zinc-300 bg-zinc-100 text-zinc-700 h-full flex-col rounded-2xl p-5"
			>
				<div>
					<span>Есть материал, история или полезная информация по теме шагов?</span>
					<p class="my-4">
						Теперь можно писать самостоятельно через открытую админку Unity One или
						написать нам в Telegram, если хотите обсудить публикацию, оформление или идею.
					</p>
					<a
						class="mb-2 flex items-center gap-1.5 p-2 underline underline-offset-4"
						href="/admin"
						><Icon name="solar:pen-2-bold-duotone" /><span>Открыть админку и написать материал</span></a
					>
					<a
						target="_blank"
						class="flex items-center gap-1.5 p-2 underline underline-offset-4"
						href="https://t.me/legion_free?text=%D0%9F%D1%80%D0%B8%D0%B2%D0%B5%D1%82!%20%D0%A5%D0%BE%D1%87%D1%83%20%D0%BE%D0%BF%D1%83%D0%B1%D0%BB%D0%B8%D0%BA%D0%BE%D0%B2%D0%B0%D1%82%D1%8C%20%D0%BC%D0%B0%D1%82%D0%B5%D1%80%D0%B8%D0%B0%D0%BB%20%D0%BD%D0%B0%20Unity%20One%20%D0%BF%D0%BE%20%D1%82%D0%B5%D0%BC%D0%B5%2012%20%D1%88%D0%B0%D0%B3%D0%BE%D0%B2.%20%D0%9C%D0%BE%D0%B6%D0%BD%D0%BE%20%D0%BA%D0%BE%D1%80%D0%BE%D1%82%D0%BA%D0%BE%20%D0%BF%D0%BE%D1%81%D0%BE%D0%B2%D0%B5%D1%82%D0%BE%D0%B2%D0%B0%D1%82%D1%8C%20%D0%BF%D0%BE%20%D1%84%D0%BE%D1%80%D0%BC%D0%B0%D1%82%D1%83%3F"
						><Icon name="solar:map-arrow-right-bold-duotone" /><span>t.me/legion_free</span></a
					>
				</div>
			</article>
		</div>
		{
			staticArticlesRest &&
				staticArticlesRest.map((article, index) => (
					<Article index={index} data={article.data} id={article.id} />
				))
		}
	</section>

	<h2 class="text-2xl font-bold">Пользовательские статьи</h2>

	<section class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
		{
			archives &&
				archives.map((item) => (
					<UserArchiveCard
						slug={item.slug}
						title={item.title}
						description={item.description}
						authorName={item.author_name}
						publishedAt={item.published_at}
					/>
				))
		}
	</section>
</Layout>
