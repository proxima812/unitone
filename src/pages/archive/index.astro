---
import Article from "@/components/Article.astro";
import ArchiveFilter from "@/components/ArchiveFilter.astro";
import Layout from "@/layouts/Layout.astro";
import { filterPublishedArchiveEntries } from "@/lib/archivePublish.mjs";
import { formatTag } from "@/lib/tags";
import { getCollection } from "astro:content";

export const prerender = true;

const posts = filterPublishedArchiveEntries(await getCollection("archive")).sort((a, b) => {
	const aTime = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
	const bTime = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
	return bTime - aTime;
});

const featuredPost = posts[0] || null;
const restPosts = posts.slice(1);
const tags = Array.from(new Set(posts.flatMap((item) => item.data.tags || []).filter(Boolean))).sort((a, b) => a.localeCompare(b));
---

<Layout title="Статьи и посты" description="Исследования, руководства и заметки о 12 шагах, сообществах и практике." hidePageHeader>
	<main class="mx-auto w-full max-w-6xl">
		<header class="grid gap-8 border-b border-[color:var(--border)] pb-12 pt-4 md:grid-cols-[1fr_auto] md:items-end md:pb-16">
			<div>
				<p class="editorial-label">Библиотека Unity One</p>
				<h1 class="mt-4 text-5xl font-black leading-[0.94] tracking-[-0.075em] md:text-7xl">Статьи<br />и посты</h1>
				<p class="mt-5 max-w-xl text-base leading-relaxed text-[color:var(--muted)] md:text-lg">Материалы о программе 12 шагов: понятные объяснения, практические руководства, история и исследования.</p>
			</div>
			<div class="grid grid-cols-2 gap-x-8 gap-y-4 border-t-[3px] border-[color:var(--text)] pt-3 text-sm md:min-w-[15rem]">
				<div><strong class="block text-2xl tracking-tight">{posts.length}</strong><span class="text-[color:var(--muted)]">материалов</span></div>
				<div><strong class="block text-2xl tracking-tight">{tags.length}</strong><span class="text-[color:var(--muted)]">тем</span></div>
			</div>
		</header>

		{featuredPost && (
			<section class="grid gap-8 border-b border-[color:var(--border)] py-10 md:grid-cols-[1.2fr_0.8fr] md:py-14">
				<div>
					<p class="editorial-label">Рекомендуемая статья</p>
					<a href={`/archive/${featuredPost.id}/`} class="group block">
						<h2 class="mt-4 max-w-4xl font-[var(--font-reading)] text-4xl font-medium leading-[0.98] tracking-[-0.045em] md:text-6xl">{featuredPost.data.title}</h2>
						{featuredPost.data.description && <p class="mt-5 max-w-2xl text-base leading-relaxed text-[color:var(--muted)] md:text-lg">{featuredPost.data.description}</p>}
						<span class="mt-6 inline-flex border-b border-[color:var(--accent)] pb-1 text-sm font-bold text-[color:var(--text)] group-hover:text-[color:var(--accent)]">Читать статью →</span>
					</a>
				</div>
				<div class="self-end border-t-[3px] border-[color:var(--text)] pt-4 text-sm leading-relaxed text-[color:var(--muted)]">
					<p class="font-semibold text-[color:var(--text)]">Что внутри</p>
					<div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
						{tags.slice(0, 8).map((tag) => <span class="border-b border-[color:var(--border)] pb-1">{formatTag(tag)}</span>)}
					</div>
					<p class="mt-6">Открывайте материалы напрямую из каталога и переходите к первичным источникам.</p>
				</div>
			</section>
		)}

		<section class="py-10 md:py-14">
			<div class="mb-7 flex flex-wrap items-end justify-between gap-4">
				<div><p class="editorial-label">Каталог</p><h2 class="mt-3 text-3xl font-bold tracking-[-0.055em] md:text-4xl">Все материалы</h2></div>
				<p class="text-sm text-[color:var(--muted)]">Сначала новые</p>
			</div>
			<ArchiveFilter tags={tags} />
			<div data-posts class="mt-9 grid grid-cols-1 gap-0">
				{restPosts.map((article) => <Article data={article.data} id={article.id} hrefBase="/archive" />)}
			</div>
		</section>
	</main>
</Layout>
