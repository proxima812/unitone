---
import Layout from "@/layouts/Layout.astro"
import { faq } from "@/data/links"

const faqSections = [
	{ id: "start", title: "Начало и выбор группы", items: faq.slice(0, 7) },
	{ id: "meetings", title: "Как проходят встречи", items: faq.slice(7, 31) },
	{ id: "safety", title: "Безопасность и профессиональная помощь", items: faq.slice(31, 42) },
	{ id: "practice", title: "Шаги, наставничество и традиции", items: faq.slice(42) },
]
---

<Layout
	title="FAQ"
	description="Частые вопросы о 12 шагах, выборе сообщества и старте практики."
	faq={faq}
>
	<section class="mx-auto flex w-full max-w-5xl flex-col gap-10">
		<nav class="mb-3 border-y border-[color:var(--border)] py-5" aria-label="Разделы FAQ">
			<h2 class="editorial-label">Разделы FAQ</h2>
			<div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
				{faqSections.map((section) => <a class="editorial-link text-sm text-[color:var(--muted)] hover:text-[color:var(--accent)]" href={`#${section.id}`}>{section.title}</a>)}
			</div>
		</nav>
		{
			faqSections.map((section) => (
			<section id={section.id} class="scroll-mt-24 space-y-0">
					<h2 class="border-b-[3px] border-[color:var(--text)] pb-3 text-2xl font-bold tracking-[-0.045em] text-[color:var(--text)]">{section.title}</h2>
					{section.items.map((item) => (
						<article class="border-b border-[color:var(--border)] py-6">
							<h3 class="mb-3 text-xl font-semibold tracking-[-0.035em] text-[color:var(--text)]">{item.question}</h3>
							<p class="max-w-3xl leading-relaxed text-[color:var(--muted)]">{item.answer}</p>
						</article>
					))}
				</section>
			))
		}
	</section>
</Layout>
