---
import Layout from "@/layouts/Layout.astro"
import { faq } from "@/data/links"
import { Icon } from "astro-icon/components"

const faqSections = [
	{ id: "start", title: "Начало и выбор группы", icon: "mdi:play-circle-outline", items: faq.slice(0, 7) },
	{ id: "meetings", title: "Как проходят встречи", icon: "mdi:account-group", items: faq.slice(7, 31) },
	{ id: "safety", title: "Безопасность и помощь", icon: "mdi:shield-check", items: faq.slice(31, 42) },
	{ id: "practice", title: "Шаги и наставничество", icon: "mdi:stairs", items: faq.slice(42) },
]
---

<Layout
	title="FAQ"
	description="Частые вопросы о 12 шагах, выборе сообщества и старте практики."
	faq={faq}
	hidePageHeader
>
	<main class="mx-auto w-full max-w-5xl">
		<!-- Hero -->
		<header class="pb-12 pt-6">
			<span class="badge mb-5">Справка</span>
			<h1 class="text-[clamp(2.5rem,7vw,4rem)] font-black leading-[0.92] tracking-[-0.04em]">
				Частые вопросы
			</h1>
			<p class="mt-5 max-w-2xl text-lg leading-relaxed text-[color:var(--text-secondary)]">
				Ответы на основные вопросы о 12 шагах, выборе сообщества и старте практики.
			</p>
		</header>

		<!-- Section Navigation -->
		<nav class="card mb-10" aria-label="Разделы FAQ">
			<h2 class="editorial-label mb-4">Перейти к разделу</h2>
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{faqSections.map((section) => (
					<a
						href={`#${section.id}`}
						class="flex items-center gap-3 rounded-lg border border-[color:var(--border)] px-4 py-3 text-sm font-medium transition-all hover:border-[color:var(--accent)] hover:bg-[color:var(--surface-hover)]"
					>
						<Icon name={section.icon} class="h-5 w-5 text-[color:var(--accent)]" />
						<span>{section.title}</span>
					</a>
				))}
			</div>
		</nav>

		<!-- FAQ Sections -->
		<div class="space-y-12">
			{faqSections.map((section) => (
				<section id={section.id} class="scroll-mt-24">
					<div class="mb-6 flex items-center gap-3 border-b border-[color:var(--border)] pb-4">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[color:var(--accent-soft)]">
							<Icon name={section.icon} class="h-5 w-5 text-[color:var(--accent)]" />
						</div>
						<h2 class="text-xl font-bold tracking-tight md:text-2xl">{section.title}</h2>
						<span class="badge badge-muted ml-auto text-xs">{section.items.length}</span>
					</div>

					<div class="divide-y divide-[color:var(--border)]">
						{section.items.map((item) => (
							<details class="group py-5">
								<summary class="flex cursor-pointer list-none items-start justify-between gap-4">
									<h3 class="text-base font-semibold leading-snug text-[color:var(--text)] md:text-lg">
										{item.question}
									</h3>
									<Icon
										name="mdi:chevron-down"
										class="mt-1 h-5 w-5 shrink-0 text-[color:var(--muted)] transition-transform group-open:rotate-180"
									/>
								</summary>
								<p class="mt-4 max-w-3xl leading-relaxed text-[color:var(--text-secondary)]">
									{item.answer}
								</p>
							</details>
						))}
					</div>
				</section>
			))}
		</div>

		<!-- CTA -->
		<section class="mt-12 border-t border-[color:var(--border)] py-10">
			<div class="card bg-[color:var(--accent-soft)] text-center">
				<Icon name="mdi:help-circle-outline" class="mx-auto h-10 w-10 text-[color:var(--accent)]" />
				<h3 class="mt-4 text-xl font-bold">Не нашли ответ?</h3>
				<p class="mx-auto mt-2 max-w-md text-sm text-[color:var(--text-secondary)]">
					Загляните в раздел статей или воспользуйтесь подбором сообщества.
				</p>
				<div class="mt-5 flex flex-wrap justify-center gap-3">
					<a href="/archive/" class="btn btn-primary">
						<span>Статьи</span>
						<Icon name="mdi:arrow-right" class="h-4 w-4" />
					</a>
					<a href="/finder/" class="btn btn-secondary">
						<span>Подбор групп</span>
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	details summary::-webkit-details-marker {
		display: none;
	}
</style>
