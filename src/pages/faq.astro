---
import Layout from "@/layouts/Layout.astro"
import { faq } from "@/data/links"

const faqSections = [
	{ id: "start", title: "Начало и выбор группы", items: faq.slice(0, 7) },
	{ id: "meetings", title: "Как проходят встречи", items: faq.slice(7, 31) },
	{ id: "safety", title: "Безопасность и профессиональная помощь", items: faq.slice(31, 42) },
	{ id: "practice", title: "Шаги, наставничество и традиции", items: faq.slice(42) },
]
---

<Layout
	title="FAQ"
	description="Частые вопросы о 12 шагах, выборе сообщества и старте практики."
	faq={faq}
>
	<section class="mx-auto flex w-full max-w-4xl flex-col gap-4">
		<nav class="mb-3 rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-5" aria-label="Разделы FAQ">
			<h2 class="text-xl font-semibold">Разделы FAQ</h2>
			<div class="mt-3 flex flex-wrap gap-2">
				{faqSections.map((section) => <a class="rounded-full border border-[color:var(--border)] px-3 py-1.5 text-sm hover:border-[color:var(--primary)]" href={`#${section.id}`}>{section.title}</a>)}
			</div>
		</nav>
		{
			faqSections.map((section) => (
				<section id={section.id} class="scroll-mt-24 space-y-4">
					<h2 class="pt-4 text-2xl font-bold text-[color:var(--text)]">{section.title}</h2>
					{section.items.map((item) => (
						<article class="rounded-2xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6">
							<h3 class="mb-3 text-2xl font-semibold text-[color:var(--text)]">{item.question}</h3>
							<p class="leading-relaxed text-[color:var(--muted)]">{item.answer}</p>
						</article>
					))}
				</section>
			))
		}
	</section>
</Layout>
