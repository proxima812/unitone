---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { methodsByTitle } from "@/data/methods";

const methodsCatalog = methodsByTitle.map((item) => ({
	slug: item.slug,
	title: item.title,
	description: item.description,
	community: item.community,
}));
---

<Layout
	title="Методы"
	description={`Понятный каталог методов: ${methodsCatalog.length} вариантов с краткими фактами и отдельной подробной страницей по каждому методу.`}
	hidePageHeader
>
	<main class="mx-auto w-full max-w-6xl">
		<!-- Hero Header -->
		<header class="grid gap-10 pb-12 pt-6 lg:grid-cols-[1.3fr_0.7fr] lg:gap-16 lg:pb-16">
			<div>
				<span class="badge mb-5">Практика</span>
				<h1 class="text-[clamp(2.5rem,7vw,5rem)] font-black leading-[0.92] tracking-[-0.04em]">
					Методы<br />работы по шагам
				</h1>
				<p class="mt-5 max-w-xl text-base leading-relaxed text-[color:var(--text-secondary)] md:text-lg">
					Подберите формат под свою задачу: воркбуки, гайды, группы и учебные материалы.
				</p>
			</div>
			<div class="flex flex-col justify-end">
				<div class="card text-center">
					<strong class="block text-3xl font-black tracking-tight text-[color:var(--accent)]">{methodsCatalog.length}</strong>
					<span class="mt-1 text-sm text-[color:var(--muted)]">методов в каталоге</span>
				</div>
			</div>
		</header>

		<!-- Methods Grid -->
		<section class="border-t border-[color:var(--border)] py-10 md:py-14">
			<div class="mb-8">
				<span class="editorial-label">Каталог методов</span>
				<h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">Выберите подход</h2>
			</div>

			<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
				{methodsCatalog.map((method, index) => (
					<a href={`/methods/${method.slug}/`} class="card card-interactive group">
						<div class="mb-4 flex items-start justify-between gap-4">
							<span class="badge badge-muted text-xs">0{index + 1}</span>
							<Icon name="mdi:arrow-right" class="h-5 w-5 text-[color:var(--muted)] transition-all group-hover:translate-x-1 group-hover:text-[color:var(--accent)]" />
						</div>
						<h3 class="text-xl font-bold tracking-tight transition-colors group-hover:text-[color:var(--accent)]">
							{method.title}
						</h3>
						{method.description && (
							<p class="mt-2 text-sm leading-relaxed text-[color:var(--muted)] line-clamp-2">
								{method.description}
							</p>
						)}
						{method.community && method.community.length > 0 && (
							<div class="mt-4 flex flex-wrap gap-1.5">
								{method.community.slice(0, 3).map((c) => (
									<span class="badge badge-muted text-[0.65rem]">{c}</span>
								))}
								{method.community.length > 3 && (
									<span class="badge badge-muted text-[0.65rem]">+{method.community.length - 3}</span>
								)}
							</div>
						)}
					</a>
				))}
			</div>
		</section>

		<!-- Info Section -->
		<section class="border-t border-[color:var(--border)] py-10 md:py-14">
			<div class="grid gap-8 lg:grid-cols-3">
				<div class="card">
					<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[color:var(--accent-soft)]">
						<Icon name="mdi:book-open-variant" class="h-6 w-6 text-[color:var(--accent)]" />
					</div>
					<h3 class="text-lg font-bold">Воркбуки</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Пошаговые рабочие тетради для самостоятельной или групповой работы.
					</p>
				</div>
				<div class="card">
					<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[color:var(--accent-soft)]">
						<Icon name="mdi:account-group" class="h-6 w-6 text-[color:var(--accent)]" />
					</div>
					<h3 class="text-lg font-bold">Группы</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Форматы групповой работы с наставником или в паре.
					</p>
				</div>
				<div class="card">
					<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[color:var(--accent-soft)]">
						<Icon name="mdi:school" class="h-6 w-6 text-[color:var(--accent)]" />
					</div>
					<h3 class="text-lg font-bold">Учебные</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Образовательные материалы и курсы для углублённого изучения.
					</p>
				</div>
			</div>
		</section>
	</main>
</Layout>
