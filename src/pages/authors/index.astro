---
import Layout from "@/layouts/Layout.astro"
import { filterPublishedArchiveEntries } from "@/lib/archivePublish.mjs"
import { getCollection } from "astro:content"

const archive = filterPublishedArchiveEntries(await getCollection("archive"))
const authorsMap = new Map<
	string,
	{
		count: number
		latest: number
	}
>()

for (const post of archive) {
	const names = Array.isArray(post.data.author) ? post.data.author : []
	const time = post.data.pubDate ? new Date(post.data.pubDate).getTime() : 0
	for (const name of names) {
		if (!name) continue
		const current = authorsMap.get(name) || { count: 0, latest: 0 }
		current.count += 1
		current.latest = Math.max(current.latest, time)
		authorsMap.set(name, current)
	}
}

const authors = [...authorsMap.entries()]
	.map(([name, meta]) => ({ name, ...meta }))
	.sort((a, b) => b.count - a.count || b.latest - a.latest)
---

<Layout
	title="Авторы"
	description="Страницы авторов и все их посты."
	hidePageHeader
>
	<main class="mx-auto w-full max-w-6xl">
	<header class="border-b border-[color:var(--border)] pb-12 pt-4 md:pb-16"><p class="editorial-label">Редакция</p><h1 class="mt-4 text-5xl font-black leading-[0.94] tracking-[-0.075em] md:text-7xl">Авторы<br />материалов</h1><p class="mt-5 max-w-xl text-base leading-relaxed text-[color:var(--muted)] md:text-lg">Прозрачные AI-авторы под редакцией Unity One. У каждого - своя логика, манера и область внимания.</p></header>
	<div class="mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-2 lg:grid-cols-3">
		{
			authors.map((author) => (
				<a
					href={`/authors/${encodeURIComponent(author.name)}/`}
					class="group border-t-[3px] border-[color:var(--text)] py-5 transition-colors hover:border-[color:var(--accent)]"
				>
					<h2 class="text-xl font-bold tracking-[-0.035em] group-hover:text-[color:var(--accent)]">{author.name}</h2>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Постов: {author.count}
					</p>
					{author.latest > 0 && (
						<p class="mt-1 text-xs text-[color:var(--muted)]">
							<span>Последняя публикация:</span>{" "}
							{new Date(author.latest).toLocaleDateString("ru-RU")}
						</p>
					)}
				</a>
			))
		}
	</div>
	</main>
</Layout>
