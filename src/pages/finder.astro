---
import { communities } from "@/data/communities"
import Layout from "@/layouts/Layout.astro"
import { Icon } from "astro-icon/components"

const filterDefinitions = [
	{ id: "alcohol", label: "Алкоголь", icon: "mdi:glass-wine", hint: "Группы по алкоголю" },
	{ id: "drugs", label: "Наркотики", icon: "mdi:pill", hint: "ПАВ и химические зависимости" },
	{ id: "nicotine", label: "Никотин", icon: "mdi:smoking-off", hint: "Курение и никотин" },
	{ id: "food", label: "Пищевое поведение", icon: "mdi:food", hint: "Переедание и РПП" },
	{ id: "gambling", label: "Игры и ставки", icon: "mdi:cards-playing", hint: "Азартные игры" },
	{ id: "sex_love", label: "Секс и отношения", icon: "mdi:heart", hint: "Любовная/сексуальная компульсивность" },
	{ id: "digital", label: "Интернет и медиа", icon: "mdi:cellphone", hint: "Диджитал-зависимости" },
	{ id: "mind", label: "Психика и эмоции", icon: "mdi:head-cog", hint: "Эмоциональные и психические трудности" },
	{ id: "family", label: "Для близких", icon: "mdi:account-group", hint: "Родные и семьи зависимых" },
	{ id: "finance", label: "Деньги и долги", icon: "mdi:cash", hint: "Долги, работа, заработок" },
	{ id: "social", label: "Социальные сложности", icon: "mdi:earth", hint: "Социальная поддержка" },
	{ id: "creative", label: "Творческие группы", icon: "mdi:palette", hint: "Творческие направления" },
	{ id: "spiritual", label: "Светские и духовные", icon: "mdi:meditation", hint: "Альтернативные модели выздоровления" },
	{ id: "general", label: "Универсальные", icon: "mdi:infinity", hint: "Общие сообщества" },
]

function includesAny(text: string, words: string[]) {
	return words.some((word) => text.includes(word))
}

function buildFacets(item: (typeof communities)[number]) {
	const text = `${item.title} ${item.description} ${item.category}`.toLowerCase()
	const facets = new Set<string>()

	if (includesAny(text, ["алкогол", "аа "])) facets.add("alcohol")
	if (includesAny(text, ["нарком", "химическ", "метамфет", "кокаин", "героин", "таблет"])) facets.add("drugs")
	if (includesAny(text, ["никотин", "кур"])) facets.add("nicotine")
	if (includesAny(text, ["пищ", "перееда", "рпп", "обжор"])) facets.add("food")
	if (includesAny(text, ["игрок", "игр", "ставк"])) facets.add("gambling")
	if (includesAny(text, ["секс", "любов", "отношен"])) facets.add("sex_love")
	if (includesAny(text, ["интернет", "медиа", "прокраст", "компьютер"])) facets.add("digital")
	if (includesAny(text, ["псих", "эмоц", "шизо", "трихот", "депресс", "неврот", "дейдример"])) facets.add("mind")
	if (includesAny(text, ["семь", "родител", "близк", "ал-анон", "алатин", "и-анон", "нар-анон"])) facets.add("family")
	if (includesAny(text, ["долг", "финанс", "безработ", "бизнес", "зарабат", "трудогол"])) facets.add("finance")
	if (includesAny(text, ["социаль", "насили", "религ", "эксплуатац", "трафикинг"])) facets.add("social")
	if (includesAny(text, ["худож", "творч"])) facets.add("creative")
	if (includesAny(text, ["smart", "refuge", "lifering", "светск", "буддий", "оксфорд"])) facets.add("spiritual")
	if (includesAny(text, ["общие зависимости", "анонимные выздоравливающие", "универс"])) facets.add("general")

	if (item.category === "♻ Общие зависимости") facets.add("general")
	if (item.category === "🧠 Психические расстройства") facets.add("mind")
	if (item.category === "👪 Поддержка для близких") facets.add("family")
	if (item.category === "💰 Финансовые трудности") facets.add("finance")
	if (item.category === "🍽️ Проблемы с пищей") facets.add("food")
	if (item.category === "🌍 Социальные проблемы") facets.add("social")
	if (item.category === "🎨 Творческие зависимости") facets.add("creative")
	if (item.category === "💊 Наркотические зависимости") facets.add("drugs")
	if (item.category === "🍷 Алкогольные зависимости") facets.add("alcohol")
	if (item.category === "🔖 Другое") facets.add("spiritual")

	if (facets.size === 0) facets.add("general")
	return [...facets]
}

const prepared = communities.map((item) => ({
	...item,
	facets: buildFacets(item),
	searchText: `${item.title} ${item.description} ${item.category}`.toLowerCase(),
	searchUrls: {
		google: `https://www.google.com/search?q=${encodeURIComponent(item.title)}`,
		yandex: `https://yandex.ru/search/?text=${encodeURIComponent(item.title)}`,
	},
}))

const availableFilters = filterDefinitions
	.map((filter) => ({
		...filter,
		count: prepared.filter((item) => item.facets.includes(filter.id)).length,
	}))
	.filter((filter) => filter.count > 0)
---

<Layout
	title="Подбор группы"
	description={`Выберите подходящее сообщество из ${communities.length} вариантов: по теме, формату запроса и жизненной ситуации.`}
	hidePageHeader
>
	<main class="mx-auto w-full max-w-6xl">
		<!-- Hero -->
		<header class="pb-12 pt-6">
			<span class="badge mb-5">Навигатор</span>
			<h1 class="text-[clamp(2.5rem,7vw,5rem)] font-black leading-[0.92] tracking-[-0.04em]">
				Подобрать<br />сообщество
			</h1>
			<p class="mt-5 max-w-xl text-base leading-relaxed text-[color:var(--text-secondary)] md:text-lg">
				Выберите тему, задайте слово для поиска и сравните доступные направления без лишнего давления.
			</p>
		</header>

		<!-- How to use -->
		<section class="card mb-8">
			<h2 class="flex items-center gap-2 text-lg font-bold">
				<Icon name="mdi:information-outline" class="h-5 w-5 text-[color:var(--accent)]" />
				<span>Как пользоваться</span>
			</h2>
			<p class="mt-2 text-sm text-[color:var(--muted)]">
				Введите ключевое слово и выберите категорию. Карточки сразу отфильтруются для быстрого поиска подходящей группы.
			</p>
		</section>

		<!-- Search & Filters -->
		<section class="border-t border-[color:var(--border)] py-8">
			<div class="flex flex-col gap-4 md:flex-row md:items-center">
				<div class="relative flex-1">
					<Icon name="mdi:magnify" class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[color:var(--muted)]" />
					<input
						id="finder-search"
						type="search"
						placeholder="Поиск: долги, никотин, семья, тревога..."
						aria-label="Поиск по сообществам"
						class="w-full rounded-xl border border-[color:var(--border)] bg-[color:var(--surface)] py-3 pl-12 pr-4 text-sm focus:border-[color:var(--accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--accent-soft)]"
					/>
				</div>
				<button
					id="finder-reset"
					type="button"
					class="btn btn-secondary"
				>
					<Icon name="mdi:refresh" class="h-4 w-4" />
					<span>Сбросить</span>
				</button>
			</div>

			<!-- Filter chips -->
			<fieldset id="finder-filters" class="mt-6 flex flex-wrap gap-2">
				<legend class="mb-2 text-sm font-medium text-[color:var(--text)]">Тема сообщества</legend>
				<button
					type="button"
					data-filter="all"
					data-active="true"
					aria-pressed="true"
					class="finder-filter badge text-sm transition-all"
				>
					Все ({prepared.length})
				</button>
				{availableFilters.map((filter) => (
					<button
						type="button"
						data-filter={filter.id}
						data-active="false"
						aria-pressed="false"
						title={filter.hint}
						class="finder-filter badge badge-muted text-sm transition-all hover:bg-[color:var(--accent-soft)] hover:text-[color:var(--accent)]"
					>
						<Icon name={filter.icon} class="h-4 w-4" />
						<span>{filter.label}</span>
						<span class="opacity-60">({filter.count})</span>
					</button>
				))}
			</fieldset>

			<p class="mt-4 text-sm text-[color:var(--muted)]" aria-live="polite">
				Найдено: <span id="finder-count" class="font-semibold text-[color:var(--text)]">{prepared.length}</span> сообществ
			</p>
		</section>

		<!-- Community Grid -->
		<section id="community-list" class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
			{prepared.map((item) => (
				<article
					data-facets={item.facets.join(",")}
					data-search={item.searchText}
					class="card card-interactive group flex flex-col"
				>
					<div class="mb-3 flex flex-wrap gap-1.5">
						{item.facets.slice(0, 2).map((facetId) => {
							const facet = availableFilters.find((x) => x.id === facetId)
							return facet ? (
								<span class="badge badge-muted text-[0.65rem]">
									<Icon name={facet.icon} class="h-3 w-3" />
									<span>{facet.label}</span>
								</span>
							) : null
						})}
					</div>

					<h3 class="text-lg font-bold leading-snug transition-colors group-hover:text-[color:var(--accent)]">
						{item.title}
					</h3>
					<p class="mt-2 flex-1 text-sm leading-relaxed text-[color:var(--muted)] line-clamp-3">
						{item.description}
					</p>

					<div class="mt-4 flex items-center justify-between gap-3 border-t border-[color:var(--border)] pt-4 text-xs">
						<span class="flex items-center gap-1.5">
							<span class={`h-2 w-2 rounded-full ${item.find ? "bg-emerald-500" : "bg-red-400"}`}></span>
							<span class="text-[color:var(--muted)]">{item.find ? "Есть инфо" : "Нет инфо"}</span>
						</span>
						{item.since && <span class="text-[color:var(--muted)]">с {item.since}</span>}
					</div>

					<div class="mt-4 flex gap-2">
						{item.wikipedia ? (
							<a
								href={item.wikipedia}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-secondary flex-1 !py-2 text-xs"
							>
								<Icon name="mdi:wikipedia" class="h-4 w-4" />
								<span>Wikipedia</span>
							</a>
						) : null}
						<a
							href={item.searchUrls.google}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-ghost flex-1 !py-2 text-xs"
						>
							<Icon name="mdi:magnify" class="h-4 w-4" />
							<span>Google</span>
						</a>
					</div>
				</article>
			))}
		</section>

		<!-- Empty State -->
		<div id="finder-empty" class="card mt-8 hidden text-center" role="status">
			<Icon name="mdi:magnify-close" class="mx-auto h-12 w-12 text-[color:var(--muted)]" />
			<p class="mt-4 text-[color:var(--muted)]">
				Ничего не найдено. Попробуйте убрать фильтр или изменить запрос.
			</p>
		</div>
	</main>

	<script>
		document.addEventListener("DOMContentLoaded", () => {
			const filters = document.querySelectorAll(".finder-filter")
			const cards = document.querySelectorAll("#community-list article")
			const searchInput = document.getElementById("finder-search") as HTMLInputElement
			const resetButton = document.getElementById("finder-reset")
			const counter = document.getElementById("finder-count")
			const emptyState = document.getElementById("finder-empty")

			let activeFilter = "all"

			const applyFilters = () => {
				const query = (searchInput?.value || "").toLowerCase().trim()
				let visibleCount = 0

				cards.forEach((card) => {
					const el = card as HTMLElement
					const facets = (el.dataset.facets || "").split(",").map((x) => x.trim())
					const searchable = el.dataset.search || ""
					const categoryMatch = activeFilter === "all" || facets.includes(activeFilter)
					const queryMatch = !query || searchable.includes(query)
					const visible = categoryMatch && queryMatch
					el.classList.toggle("hidden", !visible)
					if (visible) visibleCount += 1
				})

				if (counter) counter.textContent = String(visibleCount)
				emptyState?.classList.toggle("hidden", visibleCount !== 0)
			}

			filters.forEach((button) => {
				button.addEventListener("click", () => {
					const el = button as HTMLElement
					activeFilter = el.dataset.filter || "all"
					filters.forEach((btn) => {
						const b = btn as HTMLElement
						const active = (b.dataset.filter || "all") === activeFilter
						b.dataset.active = active ? "true" : "false"
						b.setAttribute("aria-pressed", String(active))
						b.classList.toggle("badge-muted", !active)
					})
					applyFilters()
				})
			})

			searchInput?.addEventListener("input", applyFilters)

			resetButton?.addEventListener("click", () => {
				activeFilter = "all"
				if (searchInput) searchInput.value = ""
				filters.forEach((btn) => {
					const b = btn as HTMLElement
					const active = (b.dataset.filter || "all") === "all"
						b.dataset.active = active ? "true" : "false"
						b.setAttribute("aria-pressed", String(active))
					b.classList.toggle("badge-muted", !active)
				})
				applyFilters()
			})

			applyFilters()
		})
	</script>
</Layout>
