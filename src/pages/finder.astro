---
import { communities } from "@/data/communities"
import Layout from "@/layouts/Layout.astro"
import { Icon } from "astro-icon/components"

const filterDefinitions = [
	{ id: "alcohol", label: "🍷 Алкоголь", hint: "Группы по алкоголю" },
	{ id: "drugs", label: "💊 Наркотики", hint: "ПАВ и химические зависимости" },
	{ id: "nicotine", label: "🚭 Никотин", hint: "Курение и никотин" },
	{ id: "food", label: "🍽️ Пищевое поведение", hint: "Переедание и РПП" },
	{ id: "gambling", label: "🎰 Игры и ставки", hint: "Азартные игры" },
	{ id: "sex_love", label: "❤️ Секс и отношения", hint: "Любовная/сексуальная компульсивность" },
	{ id: "digital", label: "📱 Интернет и медиа", hint: "Диджитал-зависимости" },
	{ id: "mind", label: "🧠 Психика и эмоции", hint: "Эмоциональные и психические трудности" },
	{ id: "family", label: "👪 Для близких", hint: "Родные и семьи зависимых" },
	{ id: "finance", label: "💰 Деньги и долги", hint: "Долги, работа, заработок" },
	{ id: "social", label: "🌍 Социальные сложности", hint: "Социальная поддержка" },
	{ id: "creative", label: "🎨 Творческие группы", hint: "Творческие направления" },
	{ id: "spiritual", label: "🕊️ Светские и духовные", hint: "Альтернативные модели выздоровления" },
	{ id: "general", label: "♻ Универсальные", hint: "Общие сообщества" },
]

function includesAny(text: string, words: string[]) {
	return words.some((word) => text.includes(word))
}

function buildFacets(item: (typeof communities)[number]) {
	const text = `${item.title} ${item.description} ${item.category}`.toLowerCase()
	const facets = new Set<string>()

	if (includesAny(text, ["алкогол", "аа "])) facets.add("alcohol")
	if (includesAny(text, ["нарком", "химическ", "метамфет", "кокаин", "героин", "таблет"])) facets.add("drugs")
	if (includesAny(text, ["никотин", "кур"])) facets.add("nicotine")
	if (includesAny(text, ["пищ", "перееда", "рпп", "обжор"])) facets.add("food")
	if (includesAny(text, ["игрок", "игр", "ставк"])) facets.add("gambling")
	if (includesAny(text, ["секс", "любов", "отношен"])) facets.add("sex_love")
	if (includesAny(text, ["интернет", "медиа", "прокраст", "компьютер"])) facets.add("digital")
	if (includesAny(text, ["псих", "эмоц", "шизо", "трихот", "депресс", "неврот", "дейдример"])) facets.add("mind")
	if (includesAny(text, ["семь", "родител", "близк", "ал-анон", "алатин", "и-анон", "нар-анон"])) facets.add("family")
	if (includesAny(text, ["долг", "финанс", "безработ", "бизнес", "зарабат", "трудогол"])) facets.add("finance")
	if (includesAny(text, ["социаль", "насили", "религ", "эксплуатац", "трафикинг"])) facets.add("social")
	if (includesAny(text, ["худож", "творч"])) facets.add("creative")
	if (includesAny(text, ["smart", "refuge", "lifering", "светск", "буддий", "оксфорд"])) facets.add("spiritual")
	if (includesAny(text, ["общие зависимости", "анонимные выздоравливающие", "универс"])) facets.add("general")

	if (item.category === "♻ Общие зависимости") facets.add("general")
	if (item.category === "🧠 Психические расстройства") facets.add("mind")
	if (item.category === "👪 Поддержка для близких") facets.add("family")
	if (item.category === "💰 Финансовые трудности") facets.add("finance")
	if (item.category === "🍽️ Проблемы с пищей") facets.add("food")
	if (item.category === "🌍 Социальные проблемы") facets.add("social")
	if (item.category === "🎨 Творческие зависимости") facets.add("creative")
	if (item.category === "💊 Наркотические зависимости") facets.add("drugs")
	if (item.category === "🍷 Алкогольные зависимости") facets.add("alcohol")
	if (item.category === "🔖 Другое") facets.add("spiritual")

	if (facets.size === 0) facets.add("general")
	return [...facets]
}

const prepared = communities.map((item) => ({
	...item,
	facets: buildFacets(item),
	searchText: `${item.title} ${item.description} ${item.category}`.toLowerCase(),
	searchUrls: {
		google: `https://www.google.com/search?q=${encodeURIComponent(item.title)}`,
		yandex: `https://yandex.ru/search/?text=${encodeURIComponent(item.title)}`,
		bing: `https://www.bing.com/search?q=${encodeURIComponent(item.title)}`,
		duckDuckGo: `https://duckduckgo.com/?q=${encodeURIComponent(item.title)}`,
	},
}))

const availableFilters = filterDefinitions
	.map((filter) => ({
		...filter,
		count: prepared.filter((item) => item.facets.includes(filter.id)).length,
	}))
	.filter((filter) => filter.count > 0)
---

<Layout
	title="Подбор группы"
	description={`Выберите подходящее сообщество из ${communities.length} вариантов: по теме, формату запроса и жизненной ситуации.`}
	hidePageHeader
>
	<main class="mx-auto w-full max-w-6xl">
	<header class="border-b border-[color:var(--border)] pb-12 pt-4 md:pb-16"><p class="editorial-label">Навигатор</p><h1 class="mt-4 text-5xl font-black leading-[0.94] tracking-[-0.075em] md:text-7xl">Подобрать<br />сообщество</h1><p class="mt-5 max-w-xl text-base leading-relaxed text-[color:var(--muted)] md:text-lg">Выберите тему, задайте слово для поиска и сравните доступные направления без лишнего давления.</p></header>
	<section class="border-b border-[color:var(--border)] py-8 md:py-10">
		<h2 class="text-2xl font-bold text-[color:var(--text)] md:text-3xl">Как пользоваться подбором</h2>
		<p class="mt-2 text-[color:var(--muted)]">
			Введите ключевое слово и выберите детальную категорию. Карточки ниже сразу отфильтруются,
			чтобы вы быстрее нашли подходящую группу.
		</p>

		<div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-[1fr_auto]">
			<input
				id="finder-search"
				type="search"
				placeholder="Например: долги, никотин, семья, тревога, интернет..."
				aria-label="Поиск по сообществам"
				class="w-full border border-[color:var(--border)] bg-transparent px-4 py-2.5 text-sm text-[color:var(--text)]"
			/>
			<button
				id="finder-reset"
				type="button"
				class="border border-[color:var(--border)] bg-transparent px-4 py-2.5 text-sm text-[color:var(--text)]"
			>
				Сбросить фильтры
			</button>
		</div>

		<div id="finder-filters" class="mt-4 flex flex-wrap gap-2">
			<button
				type="button"
				data-filter="all"
				data-active="true"
				class="finder-filter border-b border-[color:var(--text)] bg-transparent px-0 py-1.5 text-sm font-semibold text-[color:var(--text)]"
			>
				Все категории ({prepared.length})
			</button>
			{
				availableFilters.map((filter) => (
					<button
						type="button"
						data-filter={filter.id}
						data-active="false"
						title={filter.hint}
						class="finder-filter border-b border-[color:var(--border)] bg-transparent px-0 py-1.5 text-sm text-[color:var(--muted)]"
					>
						{filter.label} ({filter.count})
					</button>
				))
			}
		</div>
		<p class="mt-3 text-sm text-[color:var(--muted)]">
			Найдено сообществ: <span id="finder-count" class="font-semibold text-[color:var(--text)]">{prepared.length}</span>
		</p>
	</section>

	<section id="community-list" class="mt-8 grid grid-cols-1 gap-x-8 md:grid-cols-2 lg:grid-cols-3">
		{
			prepared.map((item) => (
				<article
					data-facets={item.facets.join(",")}
					data-search={item.searchText}
					class="flex h-full flex-col border-t-[3px] border-[color:var(--text)] py-5 transition-colors hover:border-[color:var(--accent)]"
				>
					<div class="p-5">
						<div class="mb-2 flex flex-wrap gap-2">
							<span class="border-b border-[color:var(--border)] pb-1 text-xs text-[color:var(--muted)]">
								{item.category}
							</span>
							{
								item.facets.slice(0, 2).map((facetId) => {
									const facet = availableFilters.find((x) => x.id === facetId)
									return facet ? (
										<span class="border-b border-[color:var(--border)] pb-1 text-xs text-[color:var(--muted)]">
											{facet.label}
										</span>
									) : null
								})
							}
						</div>
						<h3 class="text-lg font-semibold leading-tight text-[color:var(--text)]">{item.title}</h3>
						<p class="mt-2 line-clamp-3 text-sm text-[color:var(--muted)]">{item.description}</p>
					</div>

					<div class="mt-auto border-t border-[color:var(--border)] pt-4">
						<div class="mb-3 flex items-center justify-between text-sm">
							<span>
								Информация:{" "}
								<b class={item.find ? "text-emerald-600" : "text-red-600"}>{item.find ? "Есть" : "Нет"}</b>
							</span>
							<span>
								Основан:{" "}
								<b class={item.since ? "text-emerald-600" : "text-red-600"}>{item.since || "Неизвестно"}</b>
							</span>
						</div>

						<div class="flex gap-2 md:flex-nowrap flex-wrap justify-between">
							{
								item.wikipedia ? (
									<a
										href={item.wikipedia}
										aria-label={item.title}
										target="_blank"
										class="md:w-auto w-full inline-flex items-center justify-center gap-1 text-sm font-semibold text-[color:var(--text)] transition hover:text-[color:var(--accent)]"
									>
										<Icon name="mdi:book-open-page-variant" />
										<span>Wikipedia</span>
									</a>
								) : (
									<span class="md:w-auto w-full inline-flex items-center justify-center border-b border-[color:var(--border)] px-1 py-2 text-sm text-[color:var(--muted)]">
										Wikipedia нет
									</span>
								)
							}
						</div>
						<div class="mt-3 grid grid-cols-2 gap-2">
							{
								[
									["Google", item.searchUrls.google],
									["Яндекс", item.searchUrls.yandex],
									["Bing", item.searchUrls.bing],
									["DuckDuckGo", item.searchUrls.duckDuckGo],
								].map(([label, href]) => (
									<a
										href={href}
										target="_blank"
										rel="noreferrer"
										class="inline-flex items-center justify-center border-b border-[color:var(--border)] px-2 py-2 text-xs font-medium text-[color:var(--text)] transition hover:border-[color:var(--accent)]"
									>
										{label}
									</a>
								))
							}
						</div>
					</div>
				</article>
			))
		}
	</section>

	<div id="finder-empty" class="mt-6 hidden border-t border-[color:var(--border)] py-5 text-center text-[color:var(--muted)]">
		Ничего не найдено. Попробуйте убрать фильтр или изменить поисковый запрос.
	</div>
	</main>

	<script>
		document.addEventListener("DOMContentLoaded", () => {
			const filters = document.querySelectorAll(".finder-filter")
			const cards = document.querySelectorAll("#community-list article")
			const searchInput = document.getElementById("finder-search")
			const resetButton = document.getElementById("finder-reset")
			const counter = document.getElementById("finder-count")
			const emptyState = document.getElementById("finder-empty")

			let activeFilter = "all"

			const applyFilters = () => {
				const query = (searchInput?.value || "").toLowerCase().trim()
				let visibleCount = 0

				cards.forEach((card) => {
					const facets = (card.dataset.facets || "").split(",").map((x) => x.trim())
					const searchable = card.dataset.search || ""
					const categoryMatch = activeFilter === "all" || facets.includes(activeFilter)
					const queryMatch = !query || searchable.includes(query)
					const visible = categoryMatch && queryMatch
					card.classList.toggle("hidden", !visible)
					if (visible) visibleCount += 1
				})

				if (counter) counter.textContent = String(visibleCount)
				emptyState?.classList.toggle("hidden", visibleCount !== 0)
			}

			filters.forEach((button) => {
				button.addEventListener("click", () => {
					activeFilter = button.dataset.filter || "all"
					filters.forEach((btn) => {
						const active = (btn.dataset.filter || "all") === activeFilter
						btn.dataset.active = active ? "true" : "false"
						btn.classList.toggle("border-[color:var(--text)]", active)
						btn.classList.toggle("font-semibold", active)
						btn.classList.toggle("text-[color:var(--text)]", active)
						btn.classList.toggle("text-[color:var(--muted)]", !active)
					})
					applyFilters()
				})
			})

			searchInput?.addEventListener("input", applyFilters)

			resetButton?.addEventListener("click", () => {
				activeFilter = "all"
				if (searchInput) searchInput.value = ""
				filters.forEach((btn) => {
					const active = (btn.dataset.filter || "all") === "all"
					btn.dataset.active = active ? "true" : "false"
					btn.classList.toggle("border-[color:var(--text)]", active)
					btn.classList.toggle("font-semibold", active)
					btn.classList.toggle("text-[color:var(--text)]", active)
					btn.classList.toggle("text-[color:var(--muted)]", !active)
				})
				applyFilters()
			})

			applyFilters()
		})
	</script>
</Layout>
