---
import { communities } from "@/data/communities";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const sortedCommunities = [...communities].sort((a, b) => (b.wikipedia ? 1 : 0) - (a.wikipedia ? 1 : 0));
const withInfo = communities.filter(c => c.find === true).length;
---

<Layout title="Список анонимных сообществ" description={`Каталог ${communities.length} 12‑шаговых анонимных сообществ: описание, контакты и ссылки.`} hidePageHeader>
	<main class="mx-auto w-full max-w-6xl">
		<!-- Hero Header -->
		<header class="grid gap-10 pb-12 pt-6 lg:grid-cols-[1.3fr_0.7fr] lg:gap-16 lg:pb-16">
			<div>
				<span class="badge mb-5">Каталог Unity One</span>
				<h1 class="text-[clamp(2.5rem,7vw,5rem)] font-black leading-[0.92] tracking-[-0.04em]">
					Сообщества<br />взаимопомощи
				</h1>
				<p class="mt-5 max-w-xl text-base leading-relaxed text-[color:var(--text-secondary)] md:text-lg">
					Выберите направление, познакомьтесь с форматом и найдите ссылку на доступные материалы.
				</p>
			</div>
			<div class="flex flex-col justify-end">
				<div class="grid grid-cols-2 gap-4">
					<div class="card text-center">
						<strong class="block text-3xl font-black tracking-tight text-[color:var(--accent)]">{communities.length}</strong>
						<span class="mt-1 text-sm text-[color:var(--muted)]">сообществ</span>
					</div>
					<div class="card text-center">
						<strong class="block text-3xl font-black tracking-tight text-[color:var(--accent)]">{withInfo}</strong>
						<span class="mt-1 text-sm text-[color:var(--muted)]">с информацией</span>
					</div>
				</div>
			</div>
		</header>

		<!-- Communities Grid -->
		<section class="border-t border-[color:var(--border)] py-10 md:py-14">
			<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
				<div>
					<span class="editorial-label">Все направления</span>
					<h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">Каталог сообществ</h2>
				</div>
			</div>

			<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
				{sortedCommunities.map((item) => (
					<article class="card card-interactive group flex flex-col">
						<div class="mb-4 flex items-start justify-between gap-3">
							<h2 class="text-lg font-bold leading-snug tracking-tight transition-colors group-hover:text-[color:var(--accent)]">
								{item.title}
							</h2>
							{item.wikipedia && (
								<span class="badge text-[0.6rem]">Wiki</span>
							)}
						</div>

						<p class="flex-1 text-sm leading-relaxed text-[color:var(--muted)]">
							{item.description}
						</p>

						<div class="mt-5 flex items-center justify-between gap-3 border-t border-[color:var(--border)] pt-4 text-xs">
							<div class="flex items-center gap-3">
								<span class="flex items-center gap-1.5">
									<span class={`h-2 w-2 rounded-full ${item.find === true ? "bg-emerald-500" : "bg-red-400"}`}></span>
									<span class="text-[color:var(--muted)]">
										{item.find === true ? "Есть инфо" : "Нет инфо"}
									</span>
								</span>
								{item.since && (
									<span class="text-[color:var(--muted)]">
										с {item.since}
									</span>
								)}
							</div>
						</div>

						{item.wikipedia && (
							<a
								href={item.wikipedia}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--accent)] transition-colors hover:text-[color:var(--accent-hover)]"
							>
								<Icon name="mdi:book-open-page-variant" class="h-4 w-4" />
								<span>Wikipedia</span>
								<Icon name="mdi:arrow-top-right" class="h-3.5 w-3.5" />
							</a>
						)}
					</article>
				))}
			</div>
		</section>

		<!-- CTA Section -->
		<section class="border-t border-[color:var(--border)] py-10 md:py-14">
			<div class="card bg-[color:var(--accent-soft)] text-center">
				<Icon name="mdi:compass-outline" class="mx-auto h-10 w-10 text-[color:var(--accent)]" />
				<h3 class="mt-4 text-xl font-bold">Не знаете, с чего начать?</h3>
				<p class="mx-auto mt-2 max-w-md text-sm text-[color:var(--text-secondary)]">
					Пройдите короткий опрос и получите рекомендации по выбору сообщества.
				</p>
				<a href="/finder/" class="btn btn-primary mx-auto mt-6">
					<span>Подбор сообщества</span>
					<Icon name="mdi:arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</section>
	</main>
</Layout>
