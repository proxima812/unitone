---
import { communities } from "@/data/communities";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Список анонимных сообществ" description={`Каталог ${communities.length} 12‑шаговых анонимных сообществ: описание, контакты и ссылки.`} hidePageHeader>
	<main class="mx-auto w-full max-w-6xl">
		<header class="grid gap-8 border-b border-[color:var(--border)] pb-12 pt-4 md:grid-cols-[1fr_auto] md:items-end md:pb-16"><div><p class="editorial-label">Каталог Unity One</p><h1 class="mt-4 text-5xl font-black leading-[0.94] tracking-[-0.075em] md:text-7xl">Сообщества<br />взаимопомощи</h1><p class="mt-5 max-w-xl text-base leading-relaxed text-[color:var(--muted)] md:text-lg">Выберите направление, познакомьтесь с форматом и найдите ссылку на доступные материалы.</p></div><div class="border-t-[3px] border-[color:var(--text)] pt-3 text-sm"><strong class="block text-2xl tracking-tight">{communities.length}</strong><span class="text-[color:var(--muted)]">направлений в каталоге</span></div></header>
		<section class="mt-10 grid grid-cols-1 gap-x-8 md:grid-cols-2 lg:grid-cols-3">
			{communities && [...communities].sort((a, b) => (b.wikipedia ? 1 : 0) - (a.wikipedia ? 1 : 0)).map((item) => (
				<article class="group flex w-full flex-col border-t-[3px] border-[color:var(--text)] py-5 transition-colors hover:border-[color:var(--accent)]">
					<div class="flex-1"><h2 class="text-xl font-bold leading-tight tracking-[-0.035em] group-hover:text-[color:var(--accent)]">{item.title}</h2><p class="mt-2 text-sm leading-relaxed text-[color:var(--muted)]">{item.description}</p></div>
					<div class="mt-5 flex items-center justify-between gap-3 border-t border-[color:var(--border)] pt-3 text-[0.68rem] uppercase tracking-[0.08em] text-[color:var(--muted)]"><span>Информация: <b class={item.find === true ? "text-emerald-700 dark:text-emerald-400" : "text-red-700 dark:text-red-400"}>{item.find === true ? "есть" : "нет"}</b></span><span>Основан: <b class="text-[color:var(--text)]">{item.since || "неизвестно"}</b></span></div>
					{item.wikipedia && <a href={item.wikipedia} aria-label={item.title} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--text)] hover:text-[color:var(--accent)]"><Icon name="mdi:book-open-page-variant" /><span>Страница Wikipedia →</span></a>}
				</article>
			))}
		</section>
	</main>
</Layout>
