---
import { getCollection } from "astro:content";
import AppLayout from "@/layouts/AppLayout.astro";
import { buildCatalogIndex } from "@/lib/catalog/catalog";

const [communityEntries, methodEntries] = await Promise.all([
	getCollection("communities"),
	getCollection("methods"),
]);
const index = buildCatalogIndex({
	communities: communityEntries.map((entry) => ({ ...entry.data, id: entry.id })),
	methods: methodEntries.map((entry) => ({ ...entry.data, id: entry.id })),
});
const data = JSON.stringify(index.items.map(({ key, title, description, href, kind }) => ({ key, title, description, href, kind }))).replace(/</gu, "\\u003c");
---

<AppLayout title="Избранное" backHref="/app/" backLabel="Материалы">
	<section data-personal-favorites-page class="px-2 pb-8">
		<header class="pb-6"><h1 class="text-[2rem] leading-tight font-bold tracking-[-0.025em]">Избранное</h1></header>
		<div data-personal-list="favorites" class="divide-y divide-zinc-200/80 overflow-hidden rounded-2xl bg-white/80 shadow-[0_0.5px_0_rgba(0,0,0,0.12)] dark:divide-zinc-700/80 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)]"></div>
		<p data-personal-empty class="text-[1.0625rem] leading-relaxed text-zinc-600 dark:text-zinc-400">Здесь появятся сохранённые сообщества и методы. <a href="/app/" class="font-semibold text-blue-600 underline decoration-blue-600/30 underline-offset-2 dark:text-blue-400">Перейти к поиску</a></p>
		<p data-personal-status role="status" aria-live="polite" hidden class="mt-3 text-sm text-red-700 dark:text-red-300"></p>
		<template data-personal-row-template>
			<div class="flex min-h-16 items-center gap-0"><a data-personal-result-link class="group flex min-h-16 min-w-0 flex-1 items-center gap-2 rounded-xl py-3.5 pr-1 pl-4 outline-none transition-[transform,background-color] duration-100 active:scale-[0.99] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500 dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400"><span class="min-w-0 flex-1"><strong data-personal-title class="block text-[1.0625rem] leading-snug font-semibold tracking-[-0.01em]"></strong><span data-personal-description class="mt-1 line-clamp-2 block text-sm leading-snug text-zinc-600 dark:text-zinc-400"></span></span><span aria-hidden="true" class="text-xl text-zinc-400 transition-transform group-active:translate-x-0.5 dark:text-zinc-500">›</span></a><button type="button" data-favorite-toggle aria-pressed="false" class="mr-1 ml-0.5 inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-xl text-zinc-600 outline-none transition-[transform,color,background-color] duration-150 active:scale-95 aria-pressed:bg-green-50 aria-pressed:text-green-700 motion-reduce:transform-none motion-reduce:transition-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:text-zinc-300 dark:aria-pressed:bg-green-950/60 dark:aria-pressed:text-green-300 dark:focus-visible:ring-blue-400 dark:focus-visible:ring-offset-zinc-900"><svg data-favorite-icon="outline" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3.75h10.5A1.75 1.75 0 0 1 19 5.5v15.02a.48.48 0 0 1-.77.38L12 16.13 5.77 20.9a.48.48 0 0 1-.77-.38V5.5a1.75 1.75 0 0 1 1.75-1.75Z" /></svg><span data-favorite-icon="filled" aria-hidden="true" hidden><svg viewBox="0 0 24 24" fill="currentColor" class="size-5"><path d="M6.75 3A2.75 2.75 0 0 0 4 5.75v14.77a1.23 1.23 0 0 0 1.98.98L12 16.9l6.02 4.6A1.23 1.23 0 0 0 20 20.52V5.75A2.75 2.75 0 0 0 17.25 3H6.75Z" /></svg></span></button></div>
		</template>
		<noscript><p class="mt-5 text-sm text-zinc-600 dark:text-zinc-400">Избранное хранится в браузере и требует JavaScript.</p></noscript>
	</section>
</AppLayout>
<script is:inline type="application/json" data-personal-items set:html={data}></script>
<script>
	import "@/scripts/catalog-personal";
</script>
