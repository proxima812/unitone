---
import PublicationList from "@/components/publications/PublicationList.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { buildCanonical, buildJsonLd } from "@/lib/catalog/seo";
import { listPublishedPublications } from "@/lib/server/publications";

export const prerender = false;

const title = "Инструменты";
const description = "Практические инструменты для работы по шагам и поддержки восстановления.";
const path = "/app/tools/";
const publications = await listPublishedPublications({ type: "tool" });
---

<AppLayout
	title={title}
	description={description}
	canonical={buildCanonical(path)}
	keywords={["12 шагов", "инструменты 12 шагов", "работа по шагам"]}
	jsonLd={buildJsonLd(path, title, description)}
	backHref="/app/"
	backLabel="Главная"
>
	<header class="px-2 pb-6">
		<h1 class="text-[2rem] leading-tight font-bold tracking-[-0.025em]">{title}</h1>
		<p class="mt-2 text-[1.0625rem] leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>
	</header>
	<PublicationList id="tools-catalog" publications={publications} basePath={path} emptyText="Пока нет опубликованных инструментов." />
</AppLayout>
