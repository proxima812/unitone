---
import AppLayout from "@/layouts/AppLayout.astro";
import { buildCanonical, buildJsonLd } from "@/lib/catalog/seo";

const choices = [
	{ type: "material", title: "Материал", description: "Статья, памятка или разбор темы." },
	{ type: "post", title: "Пост", description: "Короткая публикация с категорией и тегами." },
	{ type: "tool", title: "Полезный инструмент", description: "Практика, сервис или способ самопомощи." },
	{ type: "experience", title: "Личный опыт", description: "История восстановления от первого лица." },
] as const;
---

<AppLayout
	title="Создать публикацию"
	description="Выбор типа новой публикации в приложении 12 шагов."
	canonical={buildCanonical("/app/create/")}
	jsonLd={buildJsonLd("/app/create/", "Создать публикацию", "Выбор типа новой публикации.")}
	backHref="/app/"
	backLabel="Главная"
>
	<section class="px-1 pb-8">
		<header class="pb-5">
			<h1 class="text-[1.75rem] leading-tight font-bold tracking-[-0.025em]">Что вы хотите создать?</h1>
			<p class="mt-2 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">Выберите тип. Публикацию можно сначала сохранить как черновик.</p>
		</header>
		<nav aria-label="Тип публикации" class="divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
			{choices.map((choice) => (
				<a href={`/app/create/${choice.type}/`} class="group flex min-h-20 items-center justify-between gap-4 px-1 py-4 outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500 dark:focus-visible:ring-blue-400">
					<span>
						<span class="block text-base font-semibold text-zinc-950 group-active:text-blue-700 dark:text-zinc-50 dark:group-active:text-blue-300">{choice.title}</span>
						<span class="mt-0.5 block text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{choice.description}</span>
					</span>
					<span aria-hidden="true" class="shrink-0 text-xl text-blue-600 dark:text-blue-400">→</span>
				</a>
			))}
			<a href="/app/new-community/" class="group flex min-h-20 items-center justify-between gap-4 px-1 py-4 outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500 dark:focus-visible:ring-blue-400">
				<span>
					<span class="block text-base font-semibold text-zinc-950 group-active:text-blue-700 dark:text-zinc-50 dark:group-active:text-blue-300">Сообщество</span>
					<span class="mt-0.5 block text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">Предложить новую группу взаимопомощи для каталога.</span>
				</span>
				<span aria-hidden="true" class="shrink-0 text-xl text-blue-600 dark:text-blue-400">→</span>
			</a>
		</nav>
	</section>
</AppLayout>
