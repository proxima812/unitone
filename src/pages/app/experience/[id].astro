---
import PublicationArticle from "@/components/publications/PublicationArticle.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { buildCanonical, buildJsonLd } from "@/lib/catalog/seo";
import { getPublicationForViewer } from "@/lib/server/publications";

export const prerender = false;

const id = Astro.params.id ?? "";
const result = id ? await getPublicationForViewer(id) : null;
const publication = result?.type === "experience" ? result : null;
if (!publication) Astro.response.status = 404;

const path = `/app/experience/${encodeURIComponent(id)}/`;
const title = publication?.title ?? "Публикация не найдена";
const description = publication?.summary ?? "Этой публикации нет или она ещё не опубликована.";
---

<AppLayout
	title={title}
	description={description}
	canonical={buildCanonical(path)}
	jsonLd={publication ? buildJsonLd(path, title, description) : undefined}
	backHref="/app/experience/"
	backLabel="Опыт"
>
	{publication ? (
		<PublicationArticle publication={publication} />
	) : (
		<section class="px-2 py-8">
			<h1 class="text-2xl font-bold tracking-[-0.02em]">Публикация не найдена</h1>
			<p class="mt-3 leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>
		</section>
	)}
</AppLayout>
