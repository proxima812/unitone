---
import { getCollection } from "astro:content";
import PersonalShelf from "@/components/catalog/PersonalShelf.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { buildCatalogIndex } from "@/lib/catalog/catalog";
import { appSeo, buildCanonical, buildJsonLd } from "@/lib/catalog/seo";
import { listPublishedPublications } from "@/lib/server/publications";

export const prerender = false;

const [communityEntries, methodEntries, materials, posts, tools, experience] = await Promise.all([
	getCollection("communities"),
	getCollection("methods"),
	listPublishedPublications({ type: "material" }),
	listPublishedPublications({ type: "post" }),
	listPublishedPublications({ type: "tool" }),
	listPublishedPublications({ type: "experience" }),
]);
const index = buildCatalogIndex({
	communities: communityEntries.map((entry) => ({ ...entry.data, id: entry.id })),
	methods: methodEntries.map((entry) => ({ ...entry.data, id: entry.id })),
});
const counts = {
	materials: materials.length,
	posts: posts.length,
	tools: tools.length,
	experience: experience.length,
	communities: communityEntries.length,
	methods: methodEntries.length,
};
---

<AppLayout
	title={appSeo.home.title}
	description={appSeo.home.description}
	canonical={buildCanonical("/app/")}
	keywords={appSeo.home.keywords}
	jsonLd={buildJsonLd("/app/", appSeo.home.title, appSeo.home.description)}
>
	<header class="px-2 pt-4 pb-5">
		<h1 class="text-[2rem] leading-tight font-bold tracking-[-0.025em]">12 шагов</h1>
		<p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">материалы · посты · полезные инструменты · опыт · и прочее</p>
	</header>

	<nav aria-label="Разделы" class="mb-6 grid grid-cols-2 gap-2">
		<a href="/app/materials/" class="flex min-h-14 items-center gap-3 rounded-2xl bg-white/80 px-3.5 py-3 text-sm font-semibold shadow-[0_0.5px_0_rgba(0,0,0,0.12)] outline-none transition-[transform,background-color] duration-100 active:scale-[0.98] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)] dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400"><span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 4.5h5.25A1.75 1.75 0 0 1 12 6.25V20a2.5 2.5 0 0 0-2.5-2.5H5V4.5ZM19 4.5h-5.25A1.75 1.75 0 0 0 12 6.25V20a2.5 2.5 0 0 1 2.5-2.5H19V4.5Z" /></svg></span><span>Материалы <span class="font-normal text-zinc-400 dark:text-zinc-500">({counts.materials})</span></span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="ml-auto size-4 shrink-0 text-zinc-400 dark:text-zinc-600"><path stroke-linecap="round" stroke-linejoin="round" d="m9.5 6 6 6-6 6" /></svg></a>
		<a href="/app/posts/" class="flex min-h-14 items-center gap-3 rounded-2xl bg-white/80 px-3.5 py-3 text-sm font-semibold shadow-[0_0.5px_0_rgba(0,0,0,0.12)] outline-none transition-[transform,background-color] duration-100 active:scale-[0.98] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)] dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400"><span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 4.5h13A1.5 1.5 0 0 1 20 6v8a1.5 1.5 0 0 1-1.5 1.5H11l-4.75 4v-4H5.5A1.5 1.5 0 0 1 4 14V6a1.5 1.5 0 0 1 1.5-1.5Z" /></svg></span><span>Посты <span class="font-normal text-zinc-400 dark:text-zinc-500">({counts.posts})</span></span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="ml-auto size-4 shrink-0 text-zinc-400 dark:text-zinc-600"><path stroke-linecap="round" stroke-linejoin="round" d="m9.5 6 6 6-6 6" /></svg></a>
		<a href="/app/tools/" class="flex min-h-14 items-center gap-3 rounded-2xl bg-white/80 px-3.5 py-3 text-sm font-semibold shadow-[0_0.5px_0_rgba(0,0,0,0.12)] outline-none transition-[transform,background-color] duration-100 active:scale-[0.98] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)] dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400"><span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4.5"><path stroke-linecap="round" stroke-linejoin="round" d="m14.75 5.25 4 4M12.5 7.5l4 4M4.75 19.25l3.15-.7 10.85-10.8-2.5-2.5L5.4 16.1l-.65 3.15Z" /></svg></span><span>Инструменты <span class="font-normal text-zinc-400 dark:text-zinc-500">({counts.tools})</span></span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="ml-auto size-4 shrink-0 text-zinc-400 dark:text-zinc-600"><path stroke-linecap="round" stroke-linejoin="round" d="m9.5 6 6 6-6 6" /></svg></a>
		<a href="/app/experience/" class="flex min-h-14 items-center gap-3 rounded-2xl bg-white/80 px-3.5 py-3 text-sm font-semibold shadow-[0_0.5px_0_rgba(0,0,0,0.12)] outline-none transition-[transform,background-color] duration-100 active:scale-[0.98] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)] dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400"><span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.5-2 7-5.25 7-9.5V5.6L12 3 5 5.6v5.15c0 4.25 2.5 7.5 7 9.5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="m9 11.5 2 2 4-4" /></svg></span><span>Опыт <span class="font-normal text-zinc-400 dark:text-zinc-500">({counts.experience})</span></span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="ml-auto size-4 shrink-0 text-zinc-400 dark:text-zinc-600"><path stroke-linecap="round" stroke-linejoin="round" d="m9.5 6 6 6-6 6" /></svg></a>
		<a href="/app/communities/" class="flex min-h-14 items-center gap-3 rounded-2xl bg-white/80 px-3.5 py-3 text-sm font-semibold shadow-[0_0.5px_0_rgba(0,0,0,0.12)] outline-none transition-[transform,background-color] duration-100 active:scale-[0.98] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)] dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400"><span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16.5 11a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M3.5 19c.5-3 2.2-4.5 4.5-4.5s4 1.5 4.5 4.5M13 19c.4-2.2 1.6-3.3 3.5-3.3s3.1 1.1 3.5 3.3" /></svg></span><span>Сообщества <span class="font-normal text-zinc-400 dark:text-zinc-500">({counts.communities})</span></span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="ml-auto size-4 shrink-0 text-zinc-400 dark:text-zinc-600"><path stroke-linecap="round" stroke-linejoin="round" d="m9.5 6 6 6-6 6" /></svg></a>
		<a href="/app/methods/" class="flex min-h-14 items-center gap-3 rounded-2xl bg-white/80 px-3.5 py-3 text-sm font-semibold shadow-[0_0.5px_0_rgba(0,0,0,0.12)] outline-none transition-[transform,background-color] duration-100 active:scale-[0.98] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)] dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400"><span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-400"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.75 6.5h1.5M4.75 12h1.5M4.75 17.5h1.5M9 6.5h10.25M9 12h10.25M9 17.5h7" /></svg></span><span>Методы <span class="font-normal text-zinc-400 dark:text-zinc-500">({counts.methods})</span></span><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="ml-auto size-4 shrink-0 text-zinc-400 dark:text-zinc-600"><path stroke-linecap="round" stroke-linejoin="round" d="m9.5 6 6 6-6 6" /></svg></a>
		<a href="/app/about/" class="col-span-2 flex min-h-14 items-center justify-center gap-2 rounded-2xl bg-blue-600 px-3.5 py-3 text-sm font-semibold text-white outline-none transition-[transform,background-color] duration-100 active:scale-[0.98] active:bg-blue-700 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:bg-blue-500 dark:active:bg-blue-600 dark:focus-visible:ring-blue-400">
			<span>О проекте</span>
			<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="m9.5 6 6 6-6 6" /></svg>
		</a>
	</nav>

	<PersonalShelf items={index.items} />
</AppLayout>
