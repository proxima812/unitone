---
import Layout from "@/layouts/Layout.astro"
import { Icon } from "astro-icon/components"
---

<Layout
	title="О проекте"
	description="О проекте Unity One: независимая база о 12 шагах, методах и сообществах."
	hidePageHeader
>
	<main class="mx-auto w-full max-w-4xl">
		<!-- Hero -->
		<header class="pb-12 pt-6">
			<span class="badge mb-5">О проекте</span>
			<h1 class="text-[clamp(2.5rem,7vw,4rem)] font-black leading-[0.92] tracking-[-0.04em]">
				Unity One
			</h1>
			<p class="mt-5 max-w-2xl text-lg leading-relaxed text-[color:var(--text-secondary)] md:text-xl">
				Независимый информационный проект о 12 шагах: статьи, методы, сообщества и прикладные материалы для знакомства с программой и регулярной практики.
			</p>
		</header>

		<!-- Mission -->
		<section class="border-t border-[color:var(--border)] py-10 md:py-14">
			<h2 class="mb-6 text-2xl font-bold tracking-tight">Цели проекта</h2>
			<div class="grid gap-4 md:grid-cols-2">
				<div class="card">
					<div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-[color:var(--accent-soft)]">
						<Icon name="mdi:format-list-bulleted" class="h-5 w-5 text-[color:var(--accent)]" />
					</div>
					<h3 class="font-semibold">Систематизация</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Систематизировать материалы о 12 шагах и сделать их доступными.
					</p>
				</div>
				<div class="card">
					<div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-[color:var(--accent-soft)]">
						<Icon name="mdi:compass-outline" class="h-5 w-5 text-[color:var(--accent)]" />
					</div>
					<h3 class="font-semibold">Навигация</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Помочь людям находить подходящие сообщества и форматы работы.
					</p>
				</div>
				<div class="card">
					<div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-[color:var(--accent-soft)]">
						<Icon name="mdi:check-decagram" class="h-5 w-5 text-[color:var(--accent)]" />
					</div>
					<h3 class="font-semibold">Проверенные практики</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Публиковать проверенные практики и методы прохождения шагов.
					</p>
				</div>
				<div class="card">
					<div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-[color:var(--accent-soft)]">
						<Icon name="mdi:heart-outline" class="h-5 w-5 text-[color:var(--accent)]" />
					</div>
					<h3 class="font-semibold">Уважение</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Поддерживать ясность, честность и уважение к личному пути каждого.
					</p>
				</div>
			</div>
		</section>

		<!-- Principles -->
		<section class="border-t border-[color:var(--border)] py-10 md:py-14">
			<h2 class="mb-6 text-2xl font-bold tracking-tight">Принципы</h2>
			<div class="space-y-4">
				<div class="card">
					<h3 class="flex items-center gap-2 font-semibold">
						<Icon name="mdi:scale-balance" class="h-5 w-5 text-[color:var(--accent)]" />
						<span>Независимость</span>
					</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						Проект не представляет интересы отдельных сообществ. Материалы собраны из открытых источников и публикуются в справочно-образовательных целях.
					</p>
				</div>
				<div class="card">
					<h3 class="flex items-center gap-2 font-semibold">
						<Icon name="mdi:eye-outline" class="h-5 w-5 text-[color:var(--accent)]" />
						<span>Прозрачность</span>
					</h3>
					<p class="mt-2 text-sm text-[color:var(--muted)]">
						На отдельных страницах могут появляться рекламные размещения. Они визуально отделены от редакционных материалов и не влияют на содержание статей.
					</p>
				</div>
			</div>
		</section>

		<!-- Contact -->
		<section class="border-t border-[color:var(--border)] py-10 md:py-14">
			<div class="card bg-[color:var(--accent-soft)] text-center">
				<Icon name="mdi:email-outline" class="mx-auto h-10 w-10 text-[color:var(--accent)]" />
				<h3 class="mt-4 text-xl font-bold">Связаться с нами</h3>
				<p class="mx-auto mt-2 max-w-md text-sm text-[color:var(--text-secondary)]">
					По вопросам сотрудничества и рекламы пишите на почту
				</p>
				<a href="mailto:ads@unityone.space" class="btn btn-primary mx-auto mt-5">
					<Icon name="mdi:send" class="h-4 w-4" />
					<span>ads@unityone.space</span>
				</a>
			</div>
		</section>
	</main>
</Layout>
