---
import Layout from "@/layouts/Layout.astro";
import { twelveSteps, twelveStepTopics } from "@/data/twelveSteps";
export function getStaticPaths() { return twelveStepTopics.map((topic) => ({ params: { topic: topic.slug }, props: { topic } })); }
const { topic } = Astro.props;
---
<Layout title={topic.title} description={topic.description}>
	<article class="mx-auto w-full max-w-4xl rounded-3xl border border-[color:var(--border)] bg-[color:var(--surface)] p-6 md:p-8">
		<h2 class="text-3xl font-bold">{topic.title}</h2><p class="mt-3 leading-relaxed text-[color:var(--muted)]">{topic.description}</p>
		{topic.slug === "spisok" ? <ol class="mt-6 space-y-3">{twelveSteps.map((step) => <li><a class="font-semibold underline" href={`/12-shagov/shag-${step.number}/`}>{step.number}. {step.title}</a><p class="mt-1 text-[color:var(--muted)]">{step.summary}</p></li>)}</ol> : <><h3 class="mt-7 text-xl font-semibold">Практический ориентир</h3><p class="mt-2 leading-relaxed text-[color:var(--muted)]">Начните с информации, затем выберите подходящую группу и задайте вопросы до или после встречи. Правила отличаются между сообществами, поэтому уточняйте их у конкретной группы. При вопросах здоровья обращайтесь к профильному специалисту.</p></>}
		<div class="mt-7 flex flex-wrap gap-3 border-t border-[color:var(--border)] pt-5"><a class="underline" href="/12-shagov/">Обзор программы</a><a class="underline" href="/faq/">FAQ</a><a class="underline" href="/finder/">Подобрать группу</a></div>
	</article>
</Layout>
