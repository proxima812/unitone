---
import Layout from "@/layouts/Layout.astro";
import { communities } from "@/data/communities";
import { blockData } from "@/data/links";
import { Icon } from "astro-icon/components";
---

<Layout
	title="12 шагов: материалы, методы и сообщества"
	description={`Единая база о 12 шагах: статьи, практики, методы и ${communities.length} сообществ.`}
	hidePageHeader
>
	<main class="mx-auto w-full max-w-6xl">
		<!-- Hero Section -->
		<section class="grid gap-10 pb-16 pt-6 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16 lg:pb-20">
			<div>
				<span class="badge mb-5">Единая база о 12 шагах</span>
				<h1 class="max-w-3xl text-[clamp(2.75rem,8vw,5.5rem)] font-black leading-[0.9] tracking-[-0.04em]">
					Знания,<br />к которым<br />можно вернуться.
				</h1>
				<p class="mt-6 max-w-xl text-lg leading-relaxed text-[color:var(--text-secondary)] md:text-xl">
					Понятные материалы о программе, сообществах и практиках личных изменений. Выберите маршрут или начните с любой темы.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/12-shagov/" class="btn btn-primary">
						<span>Начать с 12 шагов</span>
						<Icon name="mdi:arrow-right" class="h-4 w-4" />
					</a>
					<a href="/archive/" class="btn btn-secondary">
						<span>Смотреть статьи</span>
					</a>
				</div>
			</div>

			<div class="flex flex-col justify-end">
				<div class="card card-accent space-y-1">
					<a href="/12-shagov/" class="group flex items-center justify-between gap-4 rounded-lg px-1 py-3 transition-colors hover:bg-[color:var(--surface-hover)]">
						<span class="font-semibold">Начать с 12 шагов</span>
						<span class="flex items-center gap-2 text-sm text-[color:var(--muted)]">
							<span>01</span>
							<Icon name="mdi:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
						</span>
					</a>
					<div class="h-px bg-[color:var(--border)]"></div>
					<a href="/finder/" class="group flex items-center justify-between gap-4 rounded-lg px-1 py-3 transition-colors hover:bg-[color:var(--surface-hover)]">
						<span class="font-semibold">Подобрать сообщество</span>
						<span class="flex items-center gap-2 text-sm text-[color:var(--muted)]">
							<span>02</span>
							<Icon name="mdi:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
						</span>
					</a>
					<div class="h-px bg-[color:var(--border)]"></div>
					<a href="/archive/" class="group flex items-center justify-between gap-4 rounded-lg px-1 py-3 transition-colors hover:bg-[color:var(--surface-hover)]">
						<span class="font-semibold">Открыть библиотеку статей</span>
						<span class="flex items-center gap-2 text-sm text-[color:var(--muted)]">
							<span>03</span>
							<Icon name="mdi:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
						</span>
					</a>
				</div>

				<div class="mt-6 grid grid-cols-2 gap-6">
					<div class="card text-center">
						<strong class="block text-3xl font-black tracking-tight text-[color:var(--accent)]">{communities.length}</strong>
						<span class="mt-1 text-sm text-[color:var(--muted)]">сообществ</span>
					</div>
					<div class="card text-center">
						<strong class="block text-3xl font-black tracking-tight text-[color:var(--accent)]">12</strong>
						<span class="mt-1 text-sm text-[color:var(--muted)]">шагов</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Context Section -->
		<section class="grid gap-10 border-t border-[color:var(--border)] py-14 md:py-20 lg:grid-cols-[0.6fr_1.4fr]">
			<div>
				<span class="editorial-label">Контекст</span>
				<h2 class="mt-3 max-w-xs text-2xl font-bold leading-tight tracking-tight md:text-3xl">Что такое 12 шагов</h2>
			</div>
			<div class="max-w-3xl space-y-5 text-base leading-relaxed text-[color:var(--text-secondary)] md:text-lg">
				<p>12 шагов - это структурированная практика личных изменений: честный самоанализ, принятие ответственности, восстановление отношений и регулярная поддержка в сообществе.</p>
				<p>Современная модель начала формироваться в 1935 году в Акроне (Огайо), а в 1939 году была описана в книге <em class="not-italic text-[color:var(--text)]">Alcoholics Anonymous</em>. Сегодня существуют десятки 12-шаговых сообществ и форматов взаимопомощи.</p>
				<p>Даже без зависимостей отдельные практики можно использовать как систему личной гигиены: регулярную самооценку, признание ошибок, исправление ущерба в отношениях, дисциплину и поддержку сообщества.</p>
				<a class="mt-2 inline-flex items-center gap-2 font-semibold text-[color:var(--accent)] hover:underline" href="/12-shagov/">
					<span>Читать полный список 12 шагов и пояснения</span>
					<Icon name="mdi:arrow-right" class="h-4 w-4" />
				</a>
				<p class="!mt-8 text-xs leading-relaxed text-[color:var(--muted)]">
					Источники:
					<a class="editorial-link" href="https://www.history.com/articles/founding-alcoholics-anonymous" target="_blank" rel="noopener noreferrer">History.com</a>,
					<a class="editorial-link" href="https://www.britannica.com/topic/Alcoholics-Anonymous" target="_blank" rel="noopener noreferrer">Britannica</a>,
					<a class="editorial-link" href="https://www.cochrane.org/CD012880/ADDICTN_alcoholics-anonymous-and-other-12-step-programs-alcohol-use-disorder" target="_blank" rel="noopener noreferrer">Cochrane Review</a>.
				</p>
			</div>
		</section>

		<!-- Navigation Cards Section -->
		<section class="border-t border-[color:var(--border)] py-14 md:py-20">
			<div class="mb-10 flex flex-wrap items-end justify-between gap-5">
				<div>
					<span class="editorial-label">Навигация</span>
					<h2 class="mt-3 text-2xl font-bold tracking-tight md:text-3xl">Выберите свой маршрут</h2>
				</div>
				<p class="max-w-md text-sm leading-relaxed text-[color:var(--muted)]">
					Разделы проекта собраны так, чтобы можно было быстро перейти от общего понимания к конкретному действию.
				</p>
			</div>

			<div class="grid gap-4 md:grid-cols-2">
				{blockData.map((block, index) => (
					<a href={block.link} class="card card-interactive group">
						<div class="mb-4 flex items-center justify-between">
							<span class="badge badge-muted text-xs">0{index + 1}</span>
							<Icon name="mdi:arrow-right" class="h-5 w-5 text-[color:var(--muted)] transition-all group-hover:translate-x-1 group-hover:text-[color:var(--accent)]" />
						</div>
						<h3 class="text-xl font-bold tracking-tight transition-colors group-hover:text-[color:var(--accent)]">{block.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-[color:var(--muted)]">{block.description}</p>
					</a>
				))}
			</div>
		</section>

		<!-- Mission Section -->
		<section class="grid gap-8 border-t border-[color:var(--border)] py-14 md:grid-cols-[1fr_auto] md:items-end md:py-20">
			<div>
				<span class="editorial-label">Редакция Unity One</span>
				<p class="mt-4 max-w-3xl text-2xl font-medium leading-tight tracking-tight md:text-4xl lg:text-5xl">
					Собираем знания о 12 шагах в одном месте, чтобы каждый нашёл путь к ясности и поддержке.
				</p>
			</div>
			<a class="btn btn-secondary" href="/about/">
				<span>О проекте</span>
				<Icon name="mdi:arrow-right" class="h-4 w-4" />
			</a>
		</section>
	</main>
</Layout>
