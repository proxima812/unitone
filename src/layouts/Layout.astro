---
import Container from "@/components/Container.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import SeoGraph from "@/components/SeoGraph.astro";
import FeedKit from "astro-feed-kit/components/FeedKit.astro";
import clientInitUrl from "../scripts/client-init.ts?url";
import "@/styles/tailwind.css";

interface Props {
	title: string;
	description: string;
	keywords?: string;
	datePublished?: string;
	bodyStyle?: string;
	dateModified?: string;
	indexRobots?: string;
	type?: any;
	ogImage?: any;
	hidePageHeader?: boolean;
	breadcrumbCurrentLabel?: string;
	faq?: Array<{ question: string; answer: string }>;
}

const {
	datePublished,
	bodyStyle,
	dateModified,
	indexRobots,
	title,
	type,
	description,
	keywords,
	ogImage,
	hidePageHeader,
	breadcrumbCurrentLabel,
	faq,
} = Astro.props;
const cleanPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const breadcrumbParts = cleanPath.split("/").filter(Boolean);
const hiddenArchiveParts = new Set(["users", "static"]);
const visibleBreadcrumbParts = breadcrumbParts.filter((part, index) => {
	const isArchiveScope = breadcrumbParts[0] === "archive";
	const isHiddenRoutePart = index === 1 && hiddenArchiveParts.has(part);
	return !(isArchiveScope && isHiddenRoutePart);
});
const breadcrumbLabels: Record<string, string> = {
	archive: "Статьи",
	methods: "Методы",
	communities: "Сообщества",
	authors: "Авторы",
	faq: "FAQ",
	finder: "Подбор групп",
	bookmarks: "Закладки",
	about: "О проекте",
	privacy: "Конфиденциальность",
	terms: "Условия",
	disclaimer: "Дисклеймер",
	"editorial-policy": "Редакционная политика",
	"12-shagov": "12 шагов",
};
const breadcrumbs = [
	{ name: "Главная", url: new URL("/", Astro.site).href },
	...visibleBreadcrumbParts.map((part, index) => {
		const decoded = decodeURIComponent(part);
		const isLast = index === visibleBreadcrumbParts.length - 1;
		return {
			name: isLast && breadcrumbCurrentLabel
				? breadcrumbCurrentLabel
				: (breadcrumbLabels[decoded] || decoded.replace(/-/g, " ")),
			url: new URL(`/${visibleBreadcrumbParts.slice(0, index + 1).join("/")}/`, Astro.site).href,
		};
	}),
];
---

<html lang="ru" class="scroll-smooth subpixel-antialiased">
	<head>
		<SeoGraph
			title={title}
			description={description}
			keywords={keywords}
			indexRobots={indexRobots}
			ogImage={ogImage}
			type={type}
			datePublished={datePublished}
			dateModified={dateModified}
			breadcrumbs={breadcrumbs}
			faq={faq}
		/>
		<script is:inline>
			(() => {
				const savedTheme = localStorage.getItem("unityone_theme") || "system";
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				const resolvedTheme = savedTheme === "system" ? (prefersDark ? "dark" : "light") : savedTheme;
				document.documentElement.dataset.theme = resolvedTheme;
				document.documentElement.dataset.themePreference = savedTheme;
			})();
		</script>
		<link rel="manifest" href="/manifest.webmanifest" />
		<FeedKit />
		<meta name="theme-color" content="#000000" />
	</head>
	<body
		class={`${bodyStyle || ""} flex min-h-screen flex-col bg-[color:var(--bg)] text-[color:var(--text)]`}
	>
		<Header />
		<div
			id="cookie-banner"
			class="fixed bottom-4 left-1/2 z-[60] hidden w-full px-5 -translate-x-1/2 md:w-[620px] md:px-0"
		>
			<div class="rounded-2xl border-2 border-[color:var(--border)] bg-[color:var(--surface)] p-4">
				<p class="text-sm text-[color:var(--text)]">
					Этот сайт использует файлы cookie, чтобы улучшить ваш пользовательский опыт.
				</p>
				<div class="mt-3 flex flex-wrap gap-2">
					<button
						id="cookie-accept-all"
						class="rounded-full bg-[var(--sk-button-background)] px-3 py-1.5 text-sm text-[color:var(--button-text)] hover:bg-[var(--sk-button-background-hover)] active:bg-[var(--sk-button-background-active)]"
					>
						Принять все
					</button>
					<button
						id="cookie-essential-only"
						class="rounded-full border border-[color:var(--border)] px-3 py-1.5 text-sm text-[color:var(--text)] hover:border-[color:var(--primary)]"
					>
						Только необходимые
					</button>
					<button
						id="cookie-open-settings"
						class="rounded-full border border-[color:var(--border)] px-3 py-1.5 text-sm text-[color:var(--text)] hover:border-[color:var(--primary)]"
					>
						Настройки
					</button>
				</div>
				<div id="cookie-settings" class="mt-4 hidden rounded-xl border border-[color:var(--border)] p-3">
					<p class="text-sm font-medium text-[color:var(--text)]">Настройки cookie</p>
					<label class="mt-3 flex items-center justify-between gap-3 text-sm text-[color:var(--text)]">
						<span>Необходимые</span>
						<input type="checkbox" checked disabled />
					</label>
					<label class="mt-2 flex items-center justify-between gap-3 text-sm text-[color:var(--text)]">
						<span>Аналитика</span>
						<input id="cookie-analytics" type="checkbox" />
					</label>
					<label class="mt-2 flex items-center justify-between gap-3 text-sm text-[color:var(--text)]">
						<span>Реклама</span>
						<input id="cookie-ads" type="checkbox" />
					</label>
					<div class="mt-3 flex flex-wrap gap-2">
						<button
							id="cookie-save-settings"
							class="rounded-full bg-[var(--sk-button-background)] px-3 py-1.5 text-sm text-[color:var(--button-text)] hover:bg-[var(--sk-button-background-hover)] active:bg-[var(--sk-button-background-active)]"
						>
							Сохранить
						</button>
						<button
							id="cookie-close-settings"
							class="rounded-full border border-[color:var(--border)] px-3 py-1.5 text-sm text-[color:var(--text)] hover:border-[color:var(--primary)]"
						>
							Закрыть
						</button>
					</div>
				</div>
			</div>
		</div>
		<Container class="py-14 md:py-20">
			<div class="flex flex-col gap-9 md:gap-12">
        {
          Astro.url.pathname === "/" ||
					new URL(Astro.url, Astro.site).pathname === "/" ||
					hidePageHeader ? null : (
            <section class="max-w-4xl">
							{title && (
                <h1 class="mb-3 text-4xl font-black tracking-tight md:text-6xl xl:text-7xl">
									{title}
								</h1>
							)}
							{description && (
                <p class="max-w-3xl text-base leading-relaxed text-[color:var(--muted)] md:text-lg lg:text-xl">
									{description}
								</p>
							)}
						</section>
					)
				}
        <Breadcrumbs currentLabel={breadcrumbCurrentLabel} />
				<slot />
			</div>
		</Container>
		<Footer />
		<script define:vars={{ clientInitUrl }}>
			const startClientInit = () => {
				import(clientInitUrl).catch(() => {
					// no-op: keep page usable if client module fails
				});
			};

			window.addEventListener(
				"load",
				() => {
					if ("requestIdleCallback" in window) {
						window.requestIdleCallback(startClientInit, { timeout: 1500 });
					} else {
						setTimeout(startClientInit, 350);
					}
				},
				{ once: true },
			);
		</script>
	</body>
</html>
