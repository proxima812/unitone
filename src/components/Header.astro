---
import Container from "./Container.astro";
import { getReleaseMeta } from "@/lib/release";
import Logo from "./Logo.astro";
import Menu from "./Menu.astro";
import { Icon } from "astro-icon/components";

const releaseMeta = getReleaseMeta();
---

<header
	id="header"
	class="sticky top-0 z-50 w-full border-b border-[color:var(--border)] bg-[color:var(--bg)]/95 py-3 backdrop-blur-xl transition-all duration-300 will-change-transform"
>
	<Container class="flex items-center justify-between gap-4">
		<div class="flex min-w-0 items-center gap-3">
			<Logo />
			<span class="hidden text-[0.65rem] font-medium tracking-wide text-[color:var(--muted)] opacity-60 sm:inline">
				v{releaseMeta.version}
			</span>
		</div>

		<div class="flex items-center gap-1.5">
			<!-- Theme & Palette Dropdown -->
			<div class="dropdown relative" id="theme-dropdown">
				<button
					type="button"
					id="theme-dropdown-trigger"
					aria-label="Настройки темы"
					aria-expanded="false"
					aria-controls="theme-dropdown-menu"
					title="Настройки темы"
					class="icon-btn"
				>
					<Icon data-theme-icon-system name="mdi:monitor" class="h-4.5 w-4.5" />
					<Icon data-theme-icon-light name="mdi:white-balance-sunny" class="hidden h-4.5 w-4.5" />
					<Icon data-theme-icon-dark name="mdi:weather-night" class="hidden h-4.5 w-4.5" />
				</button>

				<div class="dropdown-menu w-56" id="theme-dropdown-menu" role="group" aria-label="Настройки оформления">
					<div class="dropdown-label">Режим</div>
					<button type="button" class="dropdown-item" data-theme-mode="system">
						<Icon name="mdi:monitor" class="h-4 w-4" />
						<span>Системная</span>
						<span class="ml-auto text-[color:var(--accent)] opacity-0" data-check><Icon name="mdi:check" class="h-4 w-4" /></span>
					</button>
					<button type="button" class="dropdown-item" data-theme-mode="light">
						<Icon name="mdi:white-balance-sunny" class="h-4 w-4" />
						<span>Светлая</span>
						<span class="ml-auto text-[color:var(--accent)] opacity-0" data-check><Icon name="mdi:check" class="h-4 w-4" /></span>
					</button>
					<button type="button" class="dropdown-item" data-theme-mode="dark">
						<Icon name="mdi:weather-night" class="h-4 w-4" />
						<span>Тёмная</span>
						<span class="ml-auto text-[color:var(--accent)] opacity-0" data-check><Icon name="mdi:check" class="h-4 w-4" /></span>
					</button>

					<div class="dropdown-divider"></div>

					<div class="dropdown-label">Палитра</div>
					<div class="flex items-center gap-2 px-3 py-2">
						<button
							type="button"
							class="palette-dot palette-dot-neutral"
							data-palette="neutral"
							aria-label="Нейтральная палитра"
							title="Нейтральная"
						></button>
						<button
							type="button"
							class="palette-dot palette-dot-warm"
							data-palette="warm"
							aria-label="Тёплая палитра"
							title="Тёплая"
						></button>
						<button
							type="button"
							class="palette-dot palette-dot-ocean"
							data-palette="ocean"
							aria-label="Океан палитра"
							title="Океан"
						></button>
					</div>
				</div>
			</div>

			<Menu />
		</div>
	</Container>
</header>

<script>
	const THEME_STORAGE_KEY = "unityone_theme";
	const PALETTE_STORAGE_KEY = "unityone_palette";

	const themeDropdown = document.getElementById("theme-dropdown");
	const themeDropdownTrigger = document.getElementById("theme-dropdown-trigger");
	const themeModeButtons = document.querySelectorAll("[data-theme-mode]");
	const paletteButtons = document.querySelectorAll("[data-palette]");

	const themeLabels: Record<string, string> = {
		system: "системная",
		light: "светлая",
		dark: "тёмная",
	};

	const getResolvedTheme = (preference: string) =>
		preference === "system"
			? window.matchMedia("(prefers-color-scheme: dark)").matches
				? "dark"
				: "light"
			: preference;

	const renderTheme = (preference: string) => {
		const resolvedTheme = getResolvedTheme(preference);
		document.documentElement.dataset.theme = resolvedTheme;
		document.documentElement.dataset.themePreference = preference;

		// Update trigger icon
		const icons = themeDropdownTrigger?.querySelectorAll("[data-theme-icon-system], [data-theme-icon-light], [data-theme-icon-dark]");
		icons?.forEach((icon) => {
			icon.classList.toggle("hidden", !icon.hasAttribute(`data-theme-icon-${preference}`));
		});

		// Update dropdown checkmarks
		themeModeButtons.forEach((btn) => {
			const check = btn.querySelector("[data-check]");
			const isActive = btn.getAttribute("data-theme-mode") === preference;
			check?.classList.toggle("opacity-0", !isActive);
			check?.classList.toggle("opacity-100", isActive);
			btn.classList.toggle("active", isActive);
		});

		const label = `Тема: ${themeLabels[preference]}`;
		themeDropdownTrigger?.setAttribute("aria-label", label);
		themeDropdownTrigger?.setAttribute("title", label);
	};

	const renderPalette = (palette: string) => {
		document.documentElement.dataset.palette = palette;

		paletteButtons.forEach((btn) => {
			const isActive = btn.getAttribute("data-palette") === palette;
			btn.classList.toggle("active", isActive);
		});
	};

	// Initialize
	const initialTheme = localStorage.getItem(THEME_STORAGE_KEY) || "system";
	const initialPalette = localStorage.getItem(PALETTE_STORAGE_KEY) || "neutral";
	renderTheme(initialTheme);
	renderPalette(initialPalette);

	// Toggle dropdown
	themeDropdownTrigger?.addEventListener("click", (e) => {
		e.stopPropagation();
		const open = themeDropdown?.classList.toggle("open") ?? false;
		themeDropdownTrigger?.setAttribute("aria-expanded", String(open));
	});

	// Close dropdown on outside click
	document.addEventListener("click", (e) => {
		if (!themeDropdown?.contains(e.target as Node)) {
			themeDropdown?.classList.remove("open");
			themeDropdownTrigger?.setAttribute("aria-expanded", "false");
		}
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			themeDropdown?.classList.remove("open");
			themeDropdownTrigger?.setAttribute("aria-expanded", "false");
		}
	});

	// Theme mode buttons
	themeModeButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			const mode = btn.getAttribute("data-theme-mode") || "system";
			localStorage.setItem(THEME_STORAGE_KEY, mode);
			renderTheme(mode);
		});
	});

	// Palette buttons
	paletteButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			const palette = btn.getAttribute("data-palette") || "neutral";
			localStorage.setItem(PALETTE_STORAGE_KEY, palette);
			renderPalette(palette);
		});
	});

	// System preference change
	window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
		if ((document.documentElement.dataset.themePreference || "system") === "system") {
			renderTheme("system");
		}
	});

	// Header hide/show on scroll
	const header = document.getElementById("header");
	let lastY = window.scrollY;
	let ticking = false;
	const DELTA_THRESHOLD = 8;
	const TOP_OFFSET = 24;

	const updateHeader = () => {
		const currentY = window.scrollY;

		if (!header) {
			ticking = false;
			return;
		}

		if (currentY <= TOP_OFFSET) {
			header.classList.remove("-translate-y-full");
			lastY = currentY;
			ticking = false;
			return;
		}

		const delta = currentY - lastY;
		if (Math.abs(delta) < DELTA_THRESHOLD) {
			ticking = false;
			return;
		}

		if (delta > 0) {
			header.classList.add("-translate-y-full");
		} else {
			header.classList.remove("-translate-y-full");
		}

		lastY = currentY;
		ticking = false;
	};

	window.addEventListener(
		"scroll",
		() => {
			if (ticking) return;
			ticking = true;
			window.requestAnimationFrame(updateHeader);
		},
		{ passive: true },
	);
</script>
