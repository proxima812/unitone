---
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => href === "/app/" ? pathname === "/app/" : pathname.startsWith(href);
const controlClass = (active: boolean, primary = false) => [
	"inline-flex size-12 shrink-0 items-center justify-center rounded-full outline-none transition-[transform,background-color,color,box-shadow] duration-100 active:scale-95 motion-reduce:transform-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-blue-400 dark:focus-visible:ring-offset-zinc-950",
	primary || active
		? "bg-blue-600 text-white shadow-sm dark:bg-blue-500"
		: "bg-zinc-100 text-zinc-600 active:bg-zinc-200 dark:bg-zinc-900 dark:text-zinc-300 dark:active:bg-zinc-800",
	primary && active && "ring-2 ring-blue-200 dark:ring-blue-800",
];
---

<div class="pointer-events-none fixed inset-x-0 bottom-[max(.75rem,env(safe-area-inset-bottom))] z-50 px-2.5 sm:px-4">
	<nav aria-label="Основная навигация" class="pointer-events-auto mx-auto grid w-full max-w-md grid-cols-5 rounded-[1.75rem] border border-zinc-200/80 bg-white/90 px-1.5 py-2 shadow-[0_0.75rem_2.5rem_rgba(0,0,0,0.12)] backdrop-blur-xl dark:border-zinc-800/90 dark:bg-zinc-950/90 dark:shadow-[0_0.75rem_2.5rem_rgba(0,0,0,0.45)]">
		<div class="flex min-w-0 flex-col items-center gap-1">
			<a href="/app/" aria-label="Главная" aria-current={isActive("/app/") ? "page" : undefined} class:list={controlClass(isActive("/app/"))}>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5.5"><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 10.5 8.25-7 8.25 7v8a2 2 0 0 1-2 2h-12a2 2 0 0 1-2-2v-8Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9.25 20.5v-6.25h5.5v6.25" /></svg>
			</a>
			<span aria-hidden="true" class:list={["truncate text-[0.625rem] leading-none font-medium", isActive("/app/") ? "text-blue-700 dark:text-blue-300" : "text-zinc-500 dark:text-zinc-400"]}>Главная</span>
		</div>
		<div class="flex min-w-0 flex-col items-center gap-1">
			<a href="/app/materials/" aria-label="Материалы" aria-current={isActive("/app/materials/") ? "page" : undefined} class:list={controlClass(isActive("/app/materials/"))}>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 4.5h5.25A1.75 1.75 0 0 1 12 6.25V20a2.5 2.5 0 0 0-2.5-2.5H5V4.5Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19 4.5h-5.25A1.75 1.75 0 0 0 12 6.25V20a2.5 2.5 0 0 1 2.5-2.5H19V4.5Z" /></svg>
			</a>
			<span aria-hidden="true" class:list={["truncate text-[0.625rem] leading-none font-medium", isActive("/app/materials/") ? "text-blue-700 dark:text-blue-300" : "text-zinc-500 dark:text-zinc-400"]}>Материалы</span>
		</div>
		<div class="flex min-w-0 flex-col items-center gap-1">
			<a href="/app/create/" aria-label="Создать" aria-current={isActive("/app/create/") ? "page" : undefined} class:list={controlClass(isActive("/app/create/"), true)}>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-6"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
			</a>
			<span aria-hidden="true" class:list={["truncate text-[0.625rem] leading-none font-medium", isActive("/app/create/") ? "text-blue-700 dark:text-blue-300" : "text-zinc-500 dark:text-zinc-400"]}>Создать</span>
		</div>
		<div class="flex min-w-0 flex-col items-center gap-1">
			<a href="/app/posts/" aria-label="Посты" aria-current={isActive("/app/posts/") ? "page" : undefined} class:list={controlClass(isActive("/app/posts/"))}>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 4.5h13A1.5 1.5 0 0 1 20 6v8a1.5 1.5 0 0 1-1.5 1.5H11l-4.75 4v-4H5.5A1.5 1.5 0 0 1 4 14V6a1.5 1.5 0 0 1 1.5-1.5Z" /><path stroke-linecap="round" d="M8 8h8M8 12h5" /></svg>
			</a>
			<span aria-hidden="true" class:list={["truncate text-[0.625rem] leading-none font-medium", isActive("/app/posts/") ? "text-blue-700 dark:text-blue-300" : "text-zinc-500 dark:text-zinc-400"]}>Посты</span>
		</div>
		<div class="flex min-w-0 flex-col items-center gap-1">
			<a href="/app/profile/" aria-label="Профиль" aria-current={isActive("/app/profile/") ? "page" : undefined} class:list={controlClass(isActive("/app/profile/"))}>
				<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5.5"><circle cx="12" cy="8" r="3.25" /><path stroke-linecap="round" d="M5.5 20a6.5 6.5 0 0 1 13 0" /></svg>
			</a>
			<span aria-hidden="true" class:list={["truncate text-[0.625rem] leading-none font-medium", isActive("/app/profile/") ? "text-blue-700 dark:text-blue-300" : "text-zinc-500 dark:text-zinc-400"]}>Профиль</span>
		</div>
	</nav>
</div>
