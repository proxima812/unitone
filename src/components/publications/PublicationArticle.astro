---
import { renderPublicationMarkdown } from "@/lib/publications/markdown";
import type { PublicPublication } from "@/lib/publications/types";

interface Props {
	publication: PublicPublication;
}

const { publication } = Astro.props;
const authorName = publication.authorName.trim() || "Участник сообщества";
const publishedDate = new Intl.DateTimeFormat("ru-RU", {
	day: "numeric",
	month: "long",
	year: "numeric",
}).format(new Date(publication.publishedAt));
const contentHtml = renderPublicationMarkdown(publication.content);
---

<article class="px-2 pb-8">
	{publication.type === "post" && (publication.category || publication.tags.length > 0) && (
		<div class="mb-4 flex flex-wrap gap-2" aria-label="Рубрики">
			{publication.category && <span class="rounded-full bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300">{publication.category}</span>}
			{publication.tags.map((tag) => <span class="rounded-full bg-zinc-100 px-3 py-1 text-sm text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">#{tag}</span>)}
		</div>
	)}
	<h1 class="text-[2rem] leading-[1.12] font-bold tracking-[-0.025em] text-balance">{publication.title}</h1>
	<p class="mt-4 text-[1.0625rem] leading-relaxed text-zinc-600 dark:text-zinc-400">{publication.summary}</p>
	<p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-zinc-500 dark:text-zinc-500">
		<span>{authorName}</span>
		<span aria-hidden="true">·</span>
		<time datetime={publication.publishedAt}>{publishedDate}</time>
	</p>
	<div class="app-prose mt-8" set:html={contentHtml}></div>
</article>
