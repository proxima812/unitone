<div data-publication-editor>
	<div class="relative">
		<div
			data-selection-toolbar
			hidden
			role="toolbar"
			aria-label="Форматирование текста"
			class="absolute left-1/2 top-0 z-10 flex -translate-x-1/2 -translate-y-[calc(100%+0.5rem)] items-center gap-0.5 rounded-xl bg-zinc-900 px-1 py-1 text-white shadow-lg dark:bg-zinc-100 dark:text-zinc-900"
		>
			<div data-default-actions class="flex items-center gap-0.5">
				<button type="button" data-format="bold" title="Жирный" aria-label="Жирный текст" class="inline-flex size-9 items-center justify-center rounded-lg text-sm font-bold outline-none active:bg-white/15 dark:active:bg-black/10">B</button>
				<button type="button" data-format="italic" title="Курсив" aria-label="Курсив" class="inline-flex size-9 items-center justify-center rounded-lg text-sm italic outline-none active:bg-white/15 dark:active:bg-black/10">I</button>
				<span class="mx-0.5 h-5 w-px bg-white/20 dark:bg-black/15" aria-hidden="true"></span>
				<button type="button" data-open-link title="Ссылка" aria-label="Добавить ссылку" class="inline-flex min-h-9 items-center justify-center rounded-lg px-2.5 text-sm font-semibold outline-none active:bg-white/15 dark:active:bg-black/10">Ссылка</button>
			</div>
			<div data-link-panel hidden class="flex items-center gap-1">
				<label class="sr-only" for="publication-link-url">Адрес ссылки</label>
				<input id="publication-link-url" data-link-url type="url" inputmode="url" autocomplete="url" placeholder="https://…" class="min-h-9 w-40 rounded-lg bg-white/10 px-2 text-sm text-white outline-none placeholder:text-white/50 dark:bg-black/5 dark:text-zinc-900 dark:placeholder:text-zinc-500" />
				<button type="button" data-apply-link title="Добавить" aria-label="Добавить ссылку" class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-base outline-none active:bg-white/15 dark:active:bg-black/10">✓</button>
			</div>
		</div>
		<textarea
			id="publication-content"
			data-editor-content
			name="content"
			required
			maxlength="30000"
			rows="16"
			spellcheck="true"
			placeholder="Напишите текс публикации…"
			class="w-full resize-y rounded-xl bg-white px-3 py-3 text-[0.9375rem] leading-relaxed text-zinc-950 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.14)] outline-none placeholder:text-zinc-500 focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-950 dark:text-zinc-50 dark:shadow-[inset_0_0_0_1px_rgba(255,255,255,0.18)] dark:placeholder:text-zinc-400 dark:focus-visible:ring-blue-400"
		></textarea>
	</div>
</div>

<script>
	import "@/scripts/publication-editor";
</script>
