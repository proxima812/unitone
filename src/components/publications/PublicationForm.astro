---
import PublicationEditor from "@/components/publications/PublicationEditor.astro";
import type { PublicationType } from "@/lib/publications/types";

interface Props {
	type: PublicationType;
	publicationId?: string;
}

const { type, publicationId = "" } = Astro.props;
const fieldClass = "min-h-12 w-full rounded-xl bg-white px-3 py-2.5 text-base text-zinc-950 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.14)] outline-none placeholder:text-zinc-500 focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-950 dark:text-zinc-50 dark:shadow-[inset_0_0_0_1px_rgba(255,255,255,0.18)] dark:placeholder:text-zinc-400 dark:focus-visible:ring-blue-400";
---

<form data-publication-form data-publication-type={type} data-publication-id={publicationId} class="space-y-5">
	<label class="block">
		<span class="mb-1.5 block text-sm font-semibold text-zinc-700 dark:text-zinc-200">Заголовок</span>
		<input name="title" required maxlength="120" autocomplete="off" class={fieldClass} />
	</label>

	<label class="block">
		<span class="mb-1.5 block text-sm font-semibold text-zinc-700 dark:text-zinc-200">Краткое описание</span>
		<textarea name="summary" required maxlength="400" rows="4" class={fieldClass}></textarea>
	</label>

	{type === "post" && (
		<div class="grid gap-4 sm:grid-cols-2">
			<label class="block">
				<span class="mb-1.5 block text-sm font-semibold text-zinc-700 dark:text-zinc-200">Категория</span>
				<input name="category" maxlength="80" autocomplete="off" class={fieldClass} />
			</label>
			<label class="block">
				<span class="mb-1.5 block text-sm font-semibold text-zinc-700 dark:text-zinc-200">Теги</span>
				<input name="tags" maxlength="335" autocomplete="off" placeholder="Через запятую, до 8" class={fieldClass} />
			</label>
		</div>
	)}

	<div>
		<span class="mb-1.5 block text-sm font-semibold text-zinc-700 dark:text-zinc-200">Текст</span>
		<PublicationEditor />
	</div>

	<p data-publication-status role="status" aria-live="polite" hidden class="rounded-xl bg-zinc-100 px-3 py-2.5 text-sm text-zinc-700 data-[tone=error]:bg-red-50 data-[tone=error]:text-red-700 data-[tone=success]:bg-blue-50 data-[tone=success]:text-blue-800 dark:bg-zinc-900 dark:text-zinc-300 dark:data-[tone=error]:bg-red-950/40 dark:data-[tone=error]:text-red-200 dark:data-[tone=success]:bg-blue-950/40 dark:data-[tone=success]:text-blue-200"></p>

	<div class="flex flex-col-reverse gap-2 border-t border-zinc-200 pt-4 dark:border-zinc-800 sm:flex-row sm:justify-end">
		<button type="button" data-save-draft class="inline-flex min-h-12 items-center justify-center rounded-xl border border-zinc-300 px-5 text-base font-semibold text-zinc-800 outline-none active:bg-zinc-100 disabled:pointer-events-none disabled:opacity-50 focus-visible:ring-2 focus-visible:ring-blue-500 dark:border-zinc-700 dark:text-zinc-100 dark:active:bg-zinc-900 dark:focus-visible:ring-blue-400">Сохранить черновик</button>
		<button type="submit" data-submit-review class="inline-flex min-h-12 items-center justify-center rounded-xl bg-blue-600 px-5 text-base font-semibold text-white outline-none active:bg-blue-700 disabled:pointer-events-none disabled:opacity-50 focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:bg-blue-500 dark:active:bg-blue-600 dark:focus-visible:ring-blue-400 dark:focus-visible:ring-offset-black">Отправить на проверку</button>
	</div>
</form>

<script>
	import "@/scripts/publication-form";
</script>
