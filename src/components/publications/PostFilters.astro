---
interface Props {
	targetId: string;
	categories: string[];
	tags: string[];
}

const { targetId, categories, tags } = Astro.props;
const buttonClass = "min-h-11 rounded-xl bg-zinc-100 px-3 text-sm font-medium text-zinc-700 outline-none transition-colors aria-pressed:bg-blue-600 aria-pressed:text-white focus-visible:ring-2 focus-visible:ring-blue-500 dark:bg-zinc-900 dark:text-zinc-300 dark:aria-pressed:bg-blue-500 dark:aria-pressed:text-white dark:focus-visible:ring-blue-400";
---

<section data-post-filters data-target-id={targetId} aria-label="Фильтры постов" class="mb-5 space-y-4">
	{categories.length > 0 && (
		<div>
			<h2 class="px-1 text-xs font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-500">Категории</h2>
			<div class="mt-2 flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Категория">
				<button type="button" class={buttonClass} data-filter-kind="category" data-filter-value="" aria-pressed="true">Все</button>
				{categories.map((category) => (
					<button type="button" class={buttonClass} data-filter-kind="category" data-filter-value={category} aria-pressed="false">{category}</button>
				))}
			</div>
		</div>
	)}
	{tags.length > 0 && (
		<div>
			<h2 class="px-1 text-xs font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-500">Теги</h2>
			<div class="mt-2 flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Тег">
				<button type="button" class={buttonClass} data-filter-kind="tag" data-filter-value="" aria-pressed="true">Все</button>
				{tags.map((tag) => (
					<button type="button" class={buttonClass} data-filter-kind="tag" data-filter-value={tag} aria-pressed="false">{tag}</button>
				))}
			</div>
		</div>
	)}
</section>

<script>
	import "@/scripts/post-filters";
</script>
