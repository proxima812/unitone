---
import Author from "./Author.astro"
import { Icon } from "astro-icon/components"
import { getArchiveSlug } from "@/lib/archiveSlug"

const { data, id, hrefBase = "/archive" } = Astro.props
const normalizedHrefBase = String(hrefBase).replace(/\/+$/, "")
const articleHref = `${normalizedHrefBase}/${getArchiveSlug(String(id))}/`
const publishedAt = data.pubDate

const formattedDate = publishedAt
	? new Date(publishedAt).toLocaleDateString("ru-RU", { year: "numeric", month: "short", day: "numeric" })
	: ""
---

<a
	data-tag={data.tags?.join(",") ?? ""}
	data-author={Array.isArray(data.author) ? data.author.join(",") : data.author ?? ""}
	href={articleHref}
	class="group block"
>
	<article class="card card-interactive !rounded-none border-x-0 border-b-0 !p-0">
		<div class="grid gap-4 py-6 md:grid-cols-[minmax(0,1fr)_auto] md:gap-8">
			<div class="space-y-3">
				<div class="flex flex-wrap items-center gap-2">
					{publishedAt && (
						<time datetime={String(publishedAt)} class="badge badge-muted text-[0.65rem]">
							{formattedDate}
						</time>
					)}
					{data.tags?.[0] && (
						<span class="badge text-[0.65rem]">
							{data.tags[0]}
						</span>
					)}
				</div>
				<h2 class="max-w-3xl text-xl font-bold leading-snug tracking-tight text-[color:var(--text)] transition-colors group-hover:text-[color:var(--accent)] md:text-2xl">
					{data.title}
				</h2>
				{data.description && (
					<p class="max-w-2xl text-sm leading-relaxed text-[color:var(--muted)] line-clamp-2">
						{data.description}
					</p>
				)}
			</div>
			<div class="flex items-center justify-between gap-4 md:flex-col md:items-end md:justify-between md:self-stretch">
				<Author data={data} link={false} />
				<span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[color:var(--text)] transition-colors group-hover:text-[color:var(--accent)]">
					<span>Читать</span>
					<Icon name="mdi:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
				</span>
			</div>
		</div>
	</article>
</a>
