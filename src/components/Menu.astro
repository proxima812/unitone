---
import { links } from "@/data/links";
import { cn } from "@/utils/cn";
import { Icon } from "astro-icon/components";

const hiddenMenuHrefs = new Set(["/authors", "/faq"]);
const menuLinks = links.filter((link) => !hiddenMenuHrefs.has(link.href));
---

<!-- Desktop Navigation -->
<nav class="hidden items-center gap-0.5 md:flex">
	{
		menuLinks &&
			menuLinks.map((link) => (
				<a
					href={link.href}
					title={link.label}
					class={cn(
						"nav-link",
					)}
				>
					<Icon name={link.icon} class="h-4 w-4" />
					<span>{link.label}</span>
					{link.href === "/bookmarks" && (
						<span
							id="bookmarks-count-desktop"
							class="ml-0.5 min-w-5 rounded-full bg-[color:var(--accent)] px-1.5 py-0.5 text-center text-[0.65rem] font-semibold text-white"
						>
							0
						</span>
					)}
				</a>
			))
	}
</nav>

<!-- Mobile Menu Button -->
<button
	title="Мобильное меню"
	id="open"
	type="button"
	aria-expanded="false"
	aria-controls="menu"
	class="btn btn-primary gap-1.5 px-4 py-2.5 md:hidden"
>
	<Icon name="mdi:menu" class="h-4 w-4" />
	<span>меню</span>
</button>

<!-- Mobile Menu Overlay -->
<div
	id="menu-overlay"
	class="fixed inset-0 z-40 hidden bg-black/40 backdrop-blur-sm transition-opacity"
></div>

<!-- Mobile Menu Panel -->
<div
	id="menu"
	role="dialog"
	aria-modal="true"
	aria-label="Главное меню"
	class="fixed right-0 top-0 z-50 hidden h-full w-full max-w-sm translate-x-full border-l border-[color:var(--border)] bg-[color:var(--bg)] p-6 shadow-xl transition-transform duration-300"
>
	<div class="mb-8 flex items-center justify-between">
		<span class="text-lg font-bold">Меню</span>
		<button
			id="close-menu"
			type="button"
			class="icon-btn"
			aria-label="Закрыть меню"
		>
			<Icon name="mdi:close" class="h-5 w-5" />
		</button>
	</div>

	<nav class="flex flex-col gap-2">
		{
			menuLinks &&
				menuLinks.map((link) => (
					<a
						href={link.href}
						title={link.label}
						class={cn(
							"group flex items-center gap-3 rounded-xl px-4 py-3.5 text-lg font-medium text-[color:var(--text)] transition-all hover:bg-[color:var(--surface-active)] hover:text-[color:var(--accent)]",
						)}
					>
						<Icon name={link.icon} class="h-5 w-5 text-[color:var(--muted)] transition-colors group-hover:text-[color:var(--accent)]" />
						<span>{link.label}</span>
						{link.href === "/bookmarks" && (
							<span
								id="bookmarks-count-mobile"
								class="ml-auto min-w-6 rounded-full bg-[color:var(--accent)] px-2 py-0.5 text-center text-xs font-semibold text-white"
							>
								0
							</span>
						)}
					</a>
				))
		}
	</nav>
</div>

<script>
	const menu = document.querySelector("#menu") as HTMLElement | null;
	const menuOverlay = document.querySelector("#menu-overlay");
	const menuBtn = document.querySelector("#open");
	const closeBtn = document.querySelector("#close-menu");
	const body = document.querySelector("body");
	const desktopBookmarksCount = document.querySelector("#bookmarks-count-desktop");
	const mobileBookmarksCount = document.querySelector("#bookmarks-count-mobile");
	const menuLinks = document.querySelectorAll("#menu a");
	let previouslyFocusedElement: HTMLElement | null = null;
	const BOOKMARKS_KEY = "unitone_bookmarks";

	const getBookmarksCount = () => {
		try {
			const list = JSON.parse(localStorage.getItem(BOOKMARKS_KEY) || "[]");
			return Array.isArray(list) ? list.length : 0;
		} catch {
			return 0;
		}
	};

	const renderBookmarksCount = () => {
		const count = getBookmarksCount();
		if (desktopBookmarksCount) desktopBookmarksCount.textContent = String(count);
		if (mobileBookmarksCount) mobileBookmarksCount.textContent = String(count);
	};

	const openMenu = () => {
		previouslyFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
		menu?.classList.remove("hidden", "translate-x-full");
		menuOverlay?.classList.remove("hidden");
		body?.classList.add("overflow-hidden");
		requestAnimationFrame(() => {
			menu?.classList.add("translate-x-0");
			(menu?.querySelector("a, button") as HTMLElement | null)?.focus();
		});
		menuBtn?.setAttribute("aria-expanded", "true");
	};

	const closeMenu = () => {
		menu?.classList.remove("translate-x-0");
		menu?.classList.add("translate-x-full");
		menuOverlay?.classList.add("hidden");
		body?.classList.remove("overflow-hidden");
		menuBtn?.setAttribute("aria-expanded", "false");
		previouslyFocusedElement?.focus();
		setTimeout(() => {
			menu?.classList.add("hidden");
		}, 300);
	};

	menuLinks.forEach((link) => {
		link.addEventListener("click", closeMenu);
	});

	menuBtn?.addEventListener("click", openMenu);
	closeBtn?.addEventListener("click", closeMenu);
	menuOverlay?.addEventListener("click", closeMenu);
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && !menu?.classList.contains("hidden")) closeMenu();
	});

	renderBookmarksCount();

	window.addEventListener("storage", (event) => {
		if (event.key === BOOKMARKS_KEY) {
			renderBookmarksCount();
		}
	});

	window.addEventListener("bookmarks-updated", () => {
		renderBookmarksCount();
	});
</script>
