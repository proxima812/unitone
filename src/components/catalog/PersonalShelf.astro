---
import type { CatalogItem } from "@/lib/catalog/types";

interface Props {
	items: CatalogItem[];
}

const { items } = Astro.props;
const personalItems = items.map(({ key, title, description, href, kind }) => ({ key, title, description, href, kind }));
const data = JSON.stringify(personalItems).replace(/</gu, "\\u003c");
---

<div data-personal-shelf class="mt-10 space-y-9">
	<section data-personal-section="favorites" hidden class="space-y-3">
		<div class="flex min-h-11 items-center justify-between gap-3 px-2">
			<h2 class="text-xl font-bold tracking-[-0.02em]">Избранное</h2>
			<a data-personal-all-favorites href="/app/favorites/" hidden class="inline-flex min-h-11 items-center rounded-xl px-2 text-sm font-semibold text-blue-600 outline-none transition-[transform,opacity] active:scale-[0.97] active:opacity-70 focus-visible:ring-2 focus-visible:ring-blue-500 dark:text-blue-400 dark:focus-visible:ring-blue-400">Все избранные</a>
		</div>
		<div data-personal-list="favorites" data-personal-limit="4" class="divide-y divide-zinc-200/80 overflow-hidden rounded-2xl bg-white/80 shadow-[0_0.5px_0_rgba(0,0,0,0.12)] dark:divide-zinc-700/80 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)]"></div>
		<template data-personal-row-template>
			<div class="flex min-h-16 items-center gap-2">
				<a data-personal-result-link class="group flex min-h-16 min-w-0 flex-1 items-center gap-3 rounded-xl px-5 py-4 outline-none transition-[transform,background-color] duration-100 active:scale-[0.99] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500 dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400">
					<span class="min-w-0 flex-1"><strong data-personal-title class="block text-[1.0625rem] leading-snug font-semibold tracking-[-0.01em]"></strong><span data-personal-description class="mt-1 line-clamp-2 block text-sm leading-snug text-zinc-600 dark:text-zinc-400"></span></span>
					<span aria-hidden="true" class="text-xl text-zinc-400 transition-transform group-active:translate-x-0.5 dark:text-zinc-500">›</span>
				</a>
				<button type="button" data-favorite-toggle aria-pressed="false" class="mx-2 inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-xl text-zinc-600 outline-none transition-[transform,color,background-color] duration-150 active:scale-95 aria-pressed:bg-blue-50 aria-pressed:text-blue-700 motion-reduce:transform-none motion-reduce:transition-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:text-zinc-300 dark:aria-pressed:bg-blue-950/60 dark:aria-pressed:text-blue-300 dark:focus-visible:ring-blue-400 dark:focus-visible:ring-offset-zinc-900"><svg data-favorite-icon="outline" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3.75h10.5A1.75 1.75 0 0 1 19 5.5v15.02a.48.48 0 0 1-.77.38L12 16.13 5.77 20.9a.48.48 0 0 1-.77-.38V5.5a1.75 1.75 0 0 1 1.75-1.75Z" /></svg><svg data-favorite-icon="filled" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="hidden size-5"><path d="M6.75 3A2.75 2.75 0 0 0 4 5.75v14.77a1.23 1.23 0 0 0 1.98.98L12 16.9l6.02 4.6A1.23 1.23 0 0 0 20 20.52V5.75A2.75 2.75 0 0 0 17.25 3H6.75Z" /></svg></button>
			</div>
		</template>
	</section>

	<section data-personal-section="recent" hidden class="space-y-3">
		<div class="flex min-h-11 items-center justify-between gap-3 px-2">
			<h2 class="text-xl font-bold tracking-[-0.02em]">Недавно просмотренные</h2>
			<button type="button" data-clear-recent class="inline-flex min-h-11 items-center rounded-xl px-2 text-sm font-semibold text-blue-600 outline-none transition-[transform,opacity] active:scale-[0.97] active:opacity-70 focus-visible:ring-2 focus-visible:ring-blue-500 dark:text-blue-400 dark:focus-visible:ring-blue-400" aria-label="Очистить историю недавно просмотренных">Очистить</button>
		</div>
		<div data-personal-list="recent" data-personal-limit="8" class="divide-y divide-zinc-200/80 overflow-hidden rounded-2xl bg-white/80 shadow-[0_0.5px_0_rgba(0,0,0,0.12)] dark:divide-zinc-700/80 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)]"></div>
		<template data-personal-row-template>
			<div class="flex min-h-16 items-center gap-2"><a data-personal-result-link class="group flex min-h-16 min-w-0 flex-1 items-center gap-3 rounded-xl px-5 py-4 outline-none transition-[transform,background-color] duration-100 active:scale-[0.99] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500 dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400"><span class="min-w-0 flex-1"><strong data-personal-title class="block text-[1.0625rem] leading-snug font-semibold tracking-[-0.01em]"></strong><span data-personal-description class="mt-1 line-clamp-2 block text-sm leading-snug text-zinc-600 dark:text-zinc-400"></span></span><span aria-hidden="true" class="text-xl text-zinc-400 transition-transform group-active:translate-x-0.5 dark:text-zinc-500">›</span></a></div>
		</template>
	</section>
	<p data-personal-status role="status" aria-live="polite" hidden class="px-2 text-sm text-red-700 dark:text-red-300"></p>
</div>
<script is:inline type="application/json" data-personal-items set:html={data}></script>

<script>
	import "@/scripts/catalog-personal";
</script>
