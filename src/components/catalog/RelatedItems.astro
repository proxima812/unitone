---
import type { CatalogItem } from "@/lib/catalog/types";

interface Props {
	title: string;
	items: CatalogItem[];
	moreHref?: string;
}

const { title, items, moreHref } = Astro.props;
const visibleItems = items.slice(0, 6);
const headingId = `related-items-${title.toLocaleLowerCase("ru").replace(/[^\\p{L}\\p{N}]+/gu, "-").replace(/^-+|-+$/gu, "")}`;
---

{visibleItems.length > 0 && (
	<section aria-labelledby={headingId} class="mt-10 border-t border-zinc-200/80 pt-7 dark:border-zinc-700/80">
		<h2 id={headingId} class="px-1 text-xl font-bold tracking-[-0.02em]">{title}</h2>
		<ul class="mt-3 divide-y divide-zinc-200/80 overflow-hidden rounded-2xl bg-white/80 shadow-[0_0.5px_0_rgba(0,0,0,0.12)] dark:divide-zinc-700/80 dark:bg-zinc-900/80 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)] contrast-more:ring-1 contrast-more:ring-current">
			{visibleItems.map((item) => (
				<li>
					<a href={item.href} class="group flex min-h-16 items-center gap-3 rounded-xl px-5 py-4 outline-none transition-[transform,background-color] duration-100 active:scale-[0.99] active:bg-zinc-100 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500 dark:active:bg-zinc-800 dark:focus-visible:ring-blue-400">
						<span class="min-w-0 flex-1">
							<strong class="block text-[1.0625rem] leading-snug font-semibold tracking-[-0.01em]">{item.title}</strong>
							<span class="mt-1 block text-sm leading-snug text-zinc-600 dark:text-zinc-400">{item.kind === "community" ? "Сообщество" : "Метод"} · {item.primaryLabel}</span>
						</span>
						<span aria-hidden="true" class="text-xl text-zinc-400 transition-transform group-active:translate-x-0.5 dark:text-zinc-500">›</span>
					</a>
				</li>
			))}
		</ul>
		{items.length > visibleItems.length && moreHref && (
			<a href={moreHref} class="mt-3 inline-flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold text-blue-600 outline-none transition-[transform,opacity] active:scale-[0.97] active:opacity-70 focus-visible:ring-2 focus-visible:ring-blue-500 dark:text-blue-400 dark:focus-visible:ring-blue-400">Показать все</a>
		)}
	</section>
)}
