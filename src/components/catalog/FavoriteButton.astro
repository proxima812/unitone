---
import type { CatalogKey } from "@/lib/catalog/types";

interface Props {
	itemKey: CatalogKey;
	label: string;
	variant?: "icon" | "button";
}

const { itemKey, label, variant = "icon" } = Astro.props;
const isIcon = variant === "icon";
---

<button
	type="button"
	data-favorite-toggle
	data-item-key={itemKey}
	data-favorite-label={label}
	aria-pressed="false"
	aria-label={`Добавить «${label}» в избранное`}
	class:list={[
		"inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-xl text-zinc-600 outline-none transition-[transform,color,background-color] duration-150 active:scale-95 motion-reduce:transform-none motion-reduce:transition-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:text-zinc-300 dark:focus-visible:ring-blue-400 dark:focus-visible:ring-offset-zinc-900",
		isIcon
			? "mx-2 aria-pressed:bg-blue-50 aria-pressed:text-blue-700 dark:aria-pressed:bg-blue-950/60 dark:aria-pressed:text-blue-300"
			: "gap-2 px-3 text-sm font-semibold aria-pressed:bg-blue-50 aria-pressed:text-blue-700 dark:aria-pressed:bg-blue-950/60 dark:aria-pressed:text-blue-300",
	]}
>
	<svg data-favorite-icon="outline" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5">
		<path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3.75h10.5A1.75 1.75 0 0 1 19 5.5v15.02a.48.48 0 0 1-.77.38L12 16.13 5.77 20.9a.48.48 0 0 1-.77-.38V5.5a1.75 1.75 0 0 1 1.75-1.75Z" />
	</svg>
	<svg data-favorite-icon="filled" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="hidden size-5">
		<path d="M6.75 3A2.75 2.75 0 0 0 4 5.75v14.77a1.23 1.23 0 0 0 1.98.98L12 16.9l6.02 4.6A1.23 1.23 0 0 0 20 20.52V5.75A2.75 2.75 0 0 0 17.25 3H6.75Z" />
	</svg>
	{!isIcon && <span data-favorite-text>В избранное</span>}
</button>

<script>
	import "@/scripts/catalog-personal";
</script>
