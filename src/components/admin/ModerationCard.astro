<template data-moderation-card-template>
	<li data-moderation-card>
		<article class="rounded-2xl bg-white px-4 py-5 shadow-[0_0.5px_0_rgba(0,0,0,0.12)] transition-opacity dark:bg-zinc-900 dark:shadow-[0_0.5px_0_rgba(255,255,255,0.18)] sm:px-5">
			<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">
				<span data-publication-type class="rounded-full bg-zinc-100 px-2.5 py-1 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-200"></span>
				<span aria-hidden="true">·</span>
				<time data-submitted-date></time>
			</div>

			<button
				type="button"
				data-author-toggle
				aria-expanded="false"
				class="mt-4 flex min-h-11 w-full items-center gap-3 rounded-xl text-left outline-none transition-opacity active:opacity-60 focus-visible:ring-2 focus-visible:ring-blue-500 dark:focus-visible:ring-blue-400"
			>
				<span data-author-avatar-wrap class="grid size-10 shrink-0 place-items-center overflow-hidden rounded-full bg-zinc-100 text-sm font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-200">
					<img data-author-avatar hidden alt="" class="size-full object-cover" referrerpolicy="no-referrer" />
					<span data-author-initials aria-hidden="true"></span>
				</span>
				<span class="min-w-0 flex-1">
					<span data-author-name class="block truncate text-sm font-semibold text-zinc-950 dark:text-zinc-50"></span>
					<span data-author-username hidden class="block truncate text-xs text-zinc-500 dark:text-zinc-400"></span>
				</span>
				<span class="shrink-0 text-xs font-semibold text-blue-600 dark:text-blue-400">Об авторе</span>
			</button>

			<section data-author-panel hidden class="mt-3 rounded-xl bg-zinc-50 px-3 py-3 dark:bg-zinc-950">
				<p data-author-loading hidden aria-live="polite" class="text-sm text-zinc-500 dark:text-zinc-400">Загружаем данные автора…</p>
				<p data-author-error hidden role="alert" class="text-sm text-red-700 dark:text-red-300"></p>
				<div data-author-content hidden>
					<div class="flex items-start gap-3">
						<div class="min-w-0 flex-1">
							<p data-author-profile-name class="font-semibold text-zinc-950 dark:text-zinc-50"></p>
							<p data-author-profile-username hidden class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400"></p>
						</div>
						<p data-author-telegram-id class="shrink-0 text-xs text-zinc-500 dark:text-zinc-400"></p>
					</div>
					<div class="mt-4 border-t border-zinc-200 pt-3 dark:border-zinc-800">
						<p class="text-xs font-bold uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400">Другие записи</p>
						<ul data-author-publications class="mt-2 divide-y divide-zinc-200 dark:divide-zinc-800"></ul>
					</div>
				</div>
			</section>

			<h2 data-publication-title class="mt-5 text-xl leading-snug font-bold tracking-[-0.018em] text-zinc-950 dark:text-zinc-50"></h2>
			<p data-publication-summary class="mt-2 text-[0.9375rem] leading-relaxed text-zinc-600 dark:text-zinc-400"></p>
			<div data-publication-content class="app-prose mt-6 border-t border-zinc-200 pt-5 dark:border-zinc-800"></div>

			<div class="mt-6 border-t border-zinc-200 pt-4 dark:border-zinc-800">
				<div data-primary-actions class="grid grid-cols-1 gap-2 sm:grid-cols-2">
					<button
						type="button"
						data-publish
						class="min-h-11 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white outline-none transition-[transform,opacity] active:scale-[0.99] active:opacity-80 focus-visible:ring-2 focus-visible:ring-blue-500 disabled:cursor-wait disabled:opacity-50 dark:bg-blue-500 dark:focus-visible:ring-blue-400"
					>
						Опубликовать
					</button>
					<button
						type="button"
						data-reject-toggle
						aria-expanded="false"
						class="min-h-11 rounded-xl bg-zinc-100 px-4 py-2.5 text-sm font-semibold text-zinc-800 outline-none transition-[transform,opacity] active:scale-[0.99] active:opacity-70 focus-visible:ring-2 focus-visible:ring-blue-500 disabled:cursor-wait disabled:opacity-50 dark:bg-zinc-800 dark:text-zinc-100 dark:focus-visible:ring-blue-400"
					>
						Вернуть на доработку
					</button>
				</div>

				<div data-reject-panel hidden class="mt-4">
					<label data-reject-label class="block text-sm font-semibold text-zinc-900 dark:text-zinc-100">
						Комментарий автору
						<textarea
							data-rejection-note
							required
							minlength="1"
							maxlength="1000"
							rows="4"
							placeholder="Что нужно исправить"
							class="mt-2 block w-full resize-y rounded-xl border border-zinc-300 bg-white px-3 py-3 text-base leading-relaxed text-zinc-950 outline-none placeholder:text-zinc-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:cursor-wait disabled:opacity-50 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-50 dark:focus:border-blue-400"
						></textarea>
					</label>
					<div class="mt-1 flex items-start justify-between gap-3 text-xs">
						<p data-note-error hidden role="alert" class="text-red-700 dark:text-red-300"></p>
						<p data-note-count class="ml-auto text-zinc-500 dark:text-zinc-400">0 / 1000</p>
					</div>
					<div class="mt-3 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
						<button type="button" data-reject-cancel class="min-h-11 rounded-xl px-4 py-2.5 text-sm font-semibold text-zinc-600 outline-none focus-visible:ring-2 focus-visible:ring-blue-500 disabled:cursor-wait disabled:opacity-50 dark:text-zinc-300 dark:focus-visible:ring-blue-400">Отмена</button>
						<button type="button" data-reject class="min-h-11 rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white outline-none transition-[transform,opacity] active:scale-[0.99] active:opacity-80 focus-visible:ring-2 focus-visible:ring-red-500 disabled:cursor-wait disabled:opacity-50 dark:bg-red-500">Вернуть автору</button>
					</div>
				</div>

				<p data-action-error hidden role="alert" class="mt-3 rounded-xl bg-red-50 px-3 py-2.5 text-sm text-red-700 dark:bg-red-950/40 dark:text-red-200"></p>
			</div>
		</article>
	</li>
</template>
