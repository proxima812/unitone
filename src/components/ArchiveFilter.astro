---
import { formatTag } from "@/lib/tags";

const { tags = [] } = Astro.props as { tags: string[] };
---


<section class="border-y border-[color:var(--border)] py-4" data-filter>
	<div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
		<p class="text-sm text-[color:var(--muted)]">
			Выберите теги или введите слово, результат обновится автоматически.
		</p>
	</div>
	<div class="mt-3 flex flex-wrap items-center gap-2">
		<input
			id="archive-search"
			type="search"
			placeholder="Поиск по заголовку и описанию"
			aria-label="Поиск по статьям"
			class="w-full border border-[color:var(--border)] bg-transparent px-3 py-2 text-sm md:w-80 focus:border-[color:var(--accent)] focus:outline-none"
		/>
		<button
			id="archive-reset"
			type="button"
			class="border border-[color:var(--border)] bg-transparent px-3 py-2 text-sm text-[color:var(--muted)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--text)]"
		>
			Сбросить
		</button>
	</div>
	{
		tags.length > 0 && (
			<div class="w-full overflow-x-auto pb-1">
		<div id="archive-tags" class="flex w-max min-w-full items-center gap-3 whitespace-nowrap">
					{
						tags.map((tag) => (
							<button
								type="button"
								data-tag={tag}
								data-active="false"
								class="border-b border-[color:var(--border)] bg-transparent px-0 py-1.5 text-sm text-[color:var(--muted)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--text)]"
							>
								{formatTag(tag)}
							</button>
						))
					}
				</div>
			</div>
		)
	}
	<div class="mt-3 text-xs uppercase tracking-[0.08em] text-[color:var(--muted)]">
		Найдено: <span id="archive-count"></span>
	</div>
</section>

<script is:inline>
	const initArchiveFilter = () => {
		const searchInput = document.getElementById("archive-search");
		const resetBtn = document.getElementById("archive-reset");
		const countNode = document.getElementById("archive-count");
		const posts = Array.from(document.querySelectorAll("[data-posts] [data-tag]"));
		const tagButtons = Array.from(document.querySelectorAll("#archive-tags [data-tag]"));
		const activeTags = new Set();

		const applyFilters = () => {
			const query = (searchInput?.value || "").toLowerCase().trim();
			let visibleCount = 0;

			posts.forEach((post) => {
				const postTags = (post.getAttribute("data-tag") || "")
					.split(",")
					.map((tag) => tag.toLowerCase().trim())
					.filter(Boolean);
				const text = (post.textContent || "").toLowerCase();
				const byTags =
					activeTags.size === 0 ||
					[...activeTags].some((tag) => postTags.includes(String(tag).toLowerCase().trim()));
				const byQuery = !query || text.includes(query);
				const visible = byTags && byQuery;
				post.classList.toggle("hidden", !visible);
				if (visible) visibleCount += 1;
			});

			if (countNode) countNode.textContent = String(visibleCount);
		};

		tagButtons.forEach((button) => {
			button.addEventListener("click", () => {
				const tag = button.getAttribute("data-tag") || "";
				if (!tag) return;
				if (activeTags.has(tag)) activeTags.delete(tag);
				else activeTags.add(tag);
				const active = activeTags.has(tag);
				button.setAttribute("data-active", active ? "true" : "false");
				button.classList.toggle("border-[color:var(--accent)]", active);
				button.classList.toggle("font-semibold", active);
				button.classList.toggle("text-[color:var(--text)]", active);
				button.classList.toggle("text-[color:var(--muted)]", !active);
				applyFilters();
			});
		});

		searchInput?.addEventListener("input", applyFilters);
		resetBtn?.addEventListener("click", () => {
			activeTags.clear();
			if (searchInput) searchInput.value = "";
			tagButtons.forEach((button) => {
				button.setAttribute("data-active", "false");
				button.classList.remove("border-[color:var(--accent)]", "font-semibold", "text-[color:var(--text)]");
				button.classList.add("text-[color:var(--muted)]");
			});
			applyFilters();
		});

		applyFilters();
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initArchiveFilter, { once: true });
	} else {
		initArchiveFilter();
	}
</script>
