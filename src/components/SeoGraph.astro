---
import Seo from "@jdevalk/astro-seo-graph/Seo.astro"
import { config } from "@/config"
import { buildPageGraph, DEFAULT_OG_IMAGE, SITE_NAME } from "@/lib/seo"

const {
	datePublished,
	dateModified,
	indexRobots,
	author,
	title,
	type,
	keywords = config.site.OG.keywords,
	description,
	ogImage,
	canonicalURL = new URL(Astro.url.pathname, Astro.site),
	breadcrumbs = [],
	faq,
} = Astro.props

const canonical = new URL(canonicalURL, Astro.site).href
const mainTitle = title ? `${title} • Unity One` : config.site.OG.title
const mainDescription = description || config.site.OG.description
const mainAuthor = author || config.site.OG.author
const mainOgImage = ogImage ? new URL(ogImage, Astro.site).href : DEFAULT_OG_IMAGE
const graph = buildPageGraph({
	url: canonical,
	title: mainTitle,
	description: mainDescription,
	breadcrumbs,
	datePublished,
	dateModified,
	author: mainAuthor,
	faq,
})
const extraMeta = [
	...(keywords ? [{ name: "keywords", content: keywords }] : []),
	...config.site.verifications
		.filter((item) => item.name_verification && item.content)
		.map((item) => ({ name: item.name_verification, content: item.content })),
]
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<Seo
	title={mainTitle}
	description={mainDescription}
	canonical={canonical}
	ogType={type ? "article" : "website"}
	ogImage={mainOgImage}
	ogImageAlt={mainTitle}
	ogImageWidth={1200}
	ogImageHeight={630}
	siteName={SITE_NAME}
	locale={config.site.OG.locale}
	twitter={{ card: "summary_large_image" }}
	article={datePublished ? { publishedTime: datePublished, modifiedTime: dateModified, authors: [mainAuthor] } : undefined}
	noindex={indexRobots === false}
	nofollow={indexRobots === false}
	author={mainAuthor}
	graph={graph}
	extraLinks={[
		{ rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
		{ rel: "author", type: "text/plain", href: new URL("/humans.txt", Astro.site).href },
		{ rel: "sitemap", href: "/sitemap-index.xml" },
	]}
	extraMeta={extraMeta}
/>
