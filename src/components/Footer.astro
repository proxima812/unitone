---
import { links, telegrams } from "@/data/links"
import { getReleaseMeta } from "@/lib/release"
import Container from "./Container.astro"
import Logo from "./Logo.astro"

const releaseMeta = getReleaseMeta()
const primaryLinks = links.filter((item) => ["/communities", "/methods", "/archive", "/finder"].includes(item.href))
---

<footer class="mt-10 border-t border-[color:var(--border)] bg-[color:var(--surface)]/88 backdrop-blur-xl">
	<Container>
		<div class="grid gap-10 py-12 lg:grid-cols-[1.2fr_2fr]">
			<div class="max-w-sm">
				<Logo />
				<p class="mt-4 text-sm leading-relaxed text-[color:var(--muted)]">
					Единое пространство о программе 12 шагов: сообщества, методы, статьи и ориентиры для начала пути.
				</p>
			</div>

			<div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
				<div class="flex flex-col gap-3">
					<span class="text-sm font-bold text-[color:var(--text)]">Разделы</span>
					{
						primaryLinks.map((item) => (
							<a class="text-sm text-[color:var(--muted)] hover:text-[color:var(--accent)]" href={item.href}>
								{item.label}
							</a>
						))
					}
				</div>

				<div class="flex flex-col gap-3">
					<span class="text-sm font-bold text-[color:var(--text)]">Ресурсы</span>
					{
						telegrams.map((item) => (
							<a
								class="text-sm text-[color:var(--muted)] hover:text-[color:var(--accent)]"
								target="_blank"
								rel="noopener noreferrer"
								href={item.href}
							>
								{item.label}
							</a>
						))
					}
				</div>

				<div class="flex flex-col gap-3">
					<span class="text-sm font-bold text-[color:var(--text)]">Информация</span>
					<a class="text-sm text-[color:var(--muted)] hover:text-[color:var(--accent)]" href="/about">О проекте</a>
					<a class="text-sm text-[color:var(--muted)] hover:text-[color:var(--accent)]" href="/privacy">Конфиденциальность</a>
					<a class="text-sm text-[color:var(--muted)] hover:text-[color:var(--accent)]" href="/terms">Условия использования</a>
					<a class="text-sm text-[color:var(--muted)] hover:text-[color:var(--accent)]" href="/disclaimer">Дисклеймер</a>
					<a class="text-sm text-[color:var(--muted)] hover:text-[color:var(--accent)]" href="/editorial-policy">Ред. политика</a>
				</div>
			</div>
		</div>

		<div class="flex flex-col gap-2 border-t border-[color:var(--border)] py-5 text-xs text-[color:var(--muted)] sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {new Date().getFullYear()} Unity One</p>
			<p>Версия {releaseMeta.version} · {releaseMeta.stamp}</p>
		</div>
	</Container>
</footer>
